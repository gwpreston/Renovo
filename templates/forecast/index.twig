{% extends 'layout.twig' %}

{% block title %}{{ t('nav.forecast') }} — {{ instance_name }}{% endblock %}

{% block heading %}{{ t('forecast.next_12_months') }}{% endblock %}

{% block page_actions %}
    <a class="button button-quiet" href="/forecast{{ mine_only ? '' : '?mine=1' }}">
        {{ mine_only ? t('forecast.show_whole_household') : t('forecast.show_only_my_share') }}
    </a>
{% endblock %}

{% block content %}
    <p class="muted note">
        {{ t('forecast.intro') }}
    </p>

    <section class="card">
        <div class="table-scroll">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">{{ t('field.month') }}</th>
                    <th scope="col">{{ t('field.due') }}</th>
                    <th scope="col" class="numeric">{{ t('field.total') }}</th>
                </tr>
                </thead>
                <tbody>
                {% for month in months %}
                    <tr>
                        <th scope="row">{{ month.label }}</th>
                        <td>
                            {% if month.events is empty %}
                                <span class="muted">{{ t('forecast.nothing_due') }}</span>
                            {% else %}
                                <ul class="plain forecast-events">
                                    {% for event in month.events %}
                                        <li>
                                            <a href="/subscriptions/{{ event.subscription.id }}/money">{{
                                                event.subscription.name }}</a>
                                            <span class="muted">{{ event.date|local_date('d MMM') }}</span>
                                            {% if event.reason == 'trial_conversion' %}
                                                <span class="badge badge-warning">{{ t('state.trial_converts') }}</span>
                                            {% elseif event.reason == 'one_off' %}
                                                <span class="badge">{{ t('type.one_off') }}</span>
                                            {% endif %}
                                            <span class="renewal-amount">{{
                                                event.amount.amountMinor|money(event.amount.currency) }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </td>
                        <td class="numeric">
                            {% if month.combined_minor is not null %}
                                {{ month.combined_minor|money(base_currency) }}
                                {% if peak_minor > 0 and month.combined_minor > 0 %}
                                    <div class="meter meter-slim" role="presentation">
                                        <span class="meter-fill"
                                              style="width: {{ (month.combined_minor * 100) // peak_minor }}%"></span>
                                    </div>
                                {% endif %}
                            {% else %}
                                {% for currency, amount in month.by_currency %}
                                    <div>{{ amount|money(currency) }}</div>
                                {% endfor %}
                                <div class="hint">{{ t('forecast.no_rate') }}</div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
