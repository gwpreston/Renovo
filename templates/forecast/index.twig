{% extends 'layout.twig' %}

{% block title %}Forecast — {{ instance_name }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Next 12 months</h1>
        <a class="button button-quiet" href="/forecast{{ mine_only ? '' : '?mine=1' }}">
            {{ mine_only ? 'Show the whole household' : 'Show only my share' }}
        </a>
    </div>

    <p class="muted note">
        Each renewal is shown in the month it actually falls, rather than spread evenly — a yearly bill is a
        bill in one month. Scheduled price changes and trial conversions are applied from their own dates, so
        a figure here does not move when the change eventually happens.
    </p>

    <section class="card">
        <div class="table-scroll">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">Month</th>
                    <th scope="col">Due</th>
                    <th scope="col" class="numeric">Total</th>
                </tr>
                </thead>
                <tbody>
                {% for month in months %}
                    <tr>
                        <th scope="row">{{ month.label }}</th>
                        <td>
                            {% if month.events is empty %}
                                <span class="muted">Nothing due</span>
                            {% else %}
                                <ul class="plain forecast-events">
                                    {% for event in month.events %}
                                        <li>
                                            <a href="/subscriptions/{{ event.subscription.id }}/money">{{
                                                event.subscription.name }}</a>
                                            <span class="muted">{{ event.date|date('j M') }}</span>
                                            {% if event.reason == 'trial_conversion' %}
                                                <span class="badge badge-warning">Trial converts</span>
                                            {% elseif event.reason == 'one_off' %}
                                                <span class="badge">One-off</span>
                                            {% endif %}
                                            <span class="renewal-amount">{{
                                                event.amount.amountMinor|money(event.amount.currency) }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </td>
                        <td class="numeric">
                            {% if month.combined_minor is not null %}
                                {{ month.combined_minor|money(base_currency) }}
                                {% if peak_minor > 0 and month.combined_minor > 0 %}
                                    <div class="meter meter-slim" role="presentation">
                                        <span class="meter-fill"
                                              style="width: {{ (month.combined_minor * 100) // peak_minor }}%"></span>
                                    </div>
                                {% endif %}
                            {% else %}
                                {% for currency, amount in month.by_currency %}
                                    <div>{{ amount|money(currency) }}</div>
                                {% endfor %}
                                <div class="hint">No rate to combine these.</div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
