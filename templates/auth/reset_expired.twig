{% extends 'auth/_layout.twig' %}

{% set card_icon = 'clock' %}

{% block card_title %}{{ t('auth_reset_expired.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_reset_expired.intro', {'minutes': minutes}) }}{% endblock %}

{% block card_body %}
    <a class="button button-primary auth-submit" href="/forgot-password">{{ t('auth_reset_expired.send_a_new_link') }}</a>
    <p class="auth-links"><a class="auth-back" href="/login">← {{ t('action.back_to_sign_in') }}</a></p>
{% endblock %}
