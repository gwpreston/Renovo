{% extends 'auth/_layout.twig' %}

{% set card_icon = 'lock-reset' %}

{% block card_title %}{{ t('auth_reset_password.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_reset_password.intro') }}{% endblock %}

{% block card_body %}
    {% include 'partials/errors.twig' %}

    <form method="post" action="/reset-password" class="auth-form">
        {{ csrf_field() }}
        <input type="hidden" name="token" value="{{ token }}">

        {% include 'auth/_new_password.twig' with {
            'label': t('auth_reset_password.new_password'),
            'confirm_label': t('auth_reset_password.confirm_new_password'),
            'errors': errors,
            'autofocus': true,
        } only %}

        <button type="submit" class="button button-primary auth-submit">{{ t('auth_reset_password.save_password') }}</button>
    </form>
{% endblock %}
