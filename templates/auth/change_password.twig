{% extends 'auth/_layout.twig' %}

{#
    Choose a new password, on first sign-in with a temporary one.

    A member provisioned without a mailbox signs in with the password an Owner
    gave them, and until they replace it every page they ask for is this one
    (PasswordChangeRequiredMiddleware). So it is drawn in the signed-out
    layout, with nothing on it but the form and a way out: the shell's
    navigation would be a list of links that all lead back here.

    It posts to the Profile page's own password endpoint — the same rule, the
    same service — which comes back here with a message if anything is wrong.
#}

{% set card_icon = 'lock-reset' %}

{% block card_title %}{{ t('account.must_change_heading') }}{% endblock %}
{% block card_intro %}{{ t('account.must_change_note') }}{% endblock %}

{% block card_body %}
    <form method="post" action="/profile/password" class="auth-form">
        {{ csrf_field() }}
        {# Nobody else can be signed in to an account they have just been given. #}
        <input type="hidden" name="sign_out_others" value="1">

        {% include 'auth/_password.twig' with {
            'id': 'current_password',
            'name': 'current_password',
            'label': t('account.temporary_password'),
            'autocomplete': 'current-password',
            'autofocus': true,
        } only %}

        {% include 'auth/_new_password.twig' with {
            'label': t('account.new_password'),
            'confirm_label': t('account.confirm_password'),
            'errors': {},
        } only %}

        <button type="submit" class="button button-primary auth-submit">{{ t('account.save_password') }}</button>
    </form>

    <form method="post" action="/logout" class="auth-links">
        {{ csrf_field() }}
        <button type="submit" class="button-link auth-back">{{ t('nav.sign_out') }}</button>
    </form>
{% endblock %}
