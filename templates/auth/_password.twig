{#
    A password field with a show/hide button.

    The button is a real <button>, rendered hidden: without script the field is
    a plain password field, and a control that does nothing is not offered.
    Its accessible name says what pressing it will do and changes with it —
    see assets/js/auth-forms.js.

    id, name, label, autocomplete   required
    error, autofocus, describedby   optional
    aside                           a link beside the label (Forgot password?)
#}
{% set field_error = error is defined and error ? error_message(error) : '' %}
{% set described = [
    describedby is defined and describedby ? describedby : null,
    field_error ? id ~ '-error' : null
]|filter(v => v) %}
<div class="auth-field">
    <div class="auth-label-row">
        <label for="{{ id }}">{{ label }}</label>
        {% if aside is defined and aside %}{{ aside }}{% endif %}
    </div>
    <div class="password-field" data-password-field
         data-label-show="{{ t('auth.show_password') }}" data-label-hide="{{ t('auth.hide_password') }}">
        <input type="password" id="{{ id }}" name="{{ name }}" autocomplete="{{ autocomplete }}"
               {% if described is not empty %}aria-describedby="{{ described|join(' ') }}"{% endif %}
               {% if field_error %}aria-invalid="true"{% endif %}
               required {{ autofocus|default(false) ? 'autofocus' : '' }}>
        <button type="button" class="password-toggle" aria-controls="{{ id }}" aria-pressed="false"
                aria-label="{{ t('auth.show_password') }}" hidden>
            <span class="password-toggle-show">{{ icon('show-password') }}</span>
            <span class="password-toggle-hide">{{ icon('hide-password') }}</span>
        </button>
    </div>
    {% if field_error %}<p class="field-error" id="{{ id }}-error">{{ field_error }}</p>{% endif %}
</div>
