{% extends 'layout.twig' %}

{% block title %}{{ t('auth_register_sent.title') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>{{ t('auth_register_sent.title') }}</h1>
        <p>{{ t('auth_register_sent.sent_to') }} <strong>{{ email }}</strong></p>
        <p>{{ t('auth_register_sent.follow_it') }}</p>
        <p><a class="button" href="/login">{{ t('action.back_to_sign_in') }}</a></p>
    </section>
{% endblock %}
