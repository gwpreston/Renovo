{% extends 'layout.twig' %}

{% block title %}Confirm your email — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>Check your inbox</h1>
        <p>We have sent a confirmation link to <strong>{{ email }}</strong>. Follow it to finish setting up
            your account. The link is valid for two days.</p>
        <p><a class="button" href="/login">Back to sign in</a></p>
    </section>
{% endblock %}
