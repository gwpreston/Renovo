{% extends 'auth/_layout.twig' %}

{#
    Where registration ends, and where "send it again" comes back to. The
    same page whatever became of a resend — sent, already confirmed, or no
    such account — so it cannot be used to learn who has signed up.
#}

{% set card_icon = 'mail-sent' %}

{% block card_title %}{{ t('auth_register_sent.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_register_sent.intro', {'email': email, 'days': days}) }}{% endblock %}

{% block card_body %}
    {% if errors.email is defined %}
        {% include 'auth/_alert.twig' with {'message': error_message(errors.email)} only %}
    {% elseif resent|default(false) %}
        <p class="auth-note" role="status">{{ t('auth_register_sent.resent') }}</p>
    {% endif %}

    <p class="auth-note">{{ t('auth_register_sent.nothing_arrived') }}</p>

    <div class="auth-actions">
        <form method="post" action="/verify-email/resend">
            {{ csrf_field() }}
            <input type="hidden" name="email" value="{{ email }}">
            <button type="submit" class="button auth-submit">{{ t('auth_register_sent.send_again') }}</button>
        </form>
        <a class="button button-secondary auth-submit" href="/login">{{ t('action.back_to_sign_in') }}</a>
    </div>
{% endblock %}
