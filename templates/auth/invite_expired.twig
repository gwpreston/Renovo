{% extends 'auth/_layout.twig' %}

{#
    No "request a new one" button, unlike the reset page. An invite is not
    something the invitee can ask for — only an Owner of the household can
    send another — so offering a button here would be offering a door with
    nothing behind it.
#}

{% set card_icon = 'clock' %}

{% block card_title %}{{ t('auth_invite_expired.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_invite_expired.intro') }}{% endblock %}

{% block card_body %}
    <a class="button button-primary auth-submit" href="/login">{{ t('auth.back_to_sign_in') }}</a>
{% endblock %}
