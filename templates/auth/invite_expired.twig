{% extends 'layout.twig' %}

{% block title %}{{ t('auth.link_expired') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>{{ t('auth_invite_expired.title') }}</h1>
        {#
            No "request a new one" button, unlike the reset page. An invite is
            not something the invitee can ask for — only an Owner of the
            household can send another — so offering a button here would be
            offering a door with nothing behind it.
        #}
        <p class="muted">{{ t('auth_invite_expired.intro') }}</p>
        <p><a class="button" href="/login">{{ t('auth.back_to_sign_in') }}</a></p>
    </section>
{% endblock %}
