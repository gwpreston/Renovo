{% extends 'layout.twig' %}

{% block title %}Sign in — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>Sign in</h1>

        <form method="post" action="/login" class="stack">
            {{ csrf_field() }}
            <input type="hidden" name="next" value="{{ next }}">

            <label for="email">Email address</label>
            <input type="email" id="email" name="email" value="{{ values.email|default('') }}"
                   autocomplete="username" required autofocus>
            {% if errors.email is defined %}<p class="field-error">{{ errors.email }}</p>{% endif %}

            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
            {% if errors.password is defined %}<p class="field-error">{{ errors.password }}</p>{% endif %}

            <button type="submit" class="button button-primary">Sign in</button>
        </form>

        {#
            Offered beside the password form rather than behind it: a passkey is
            a way of signing in, not a fallback for one.
        #}
        <hr class="divider">

        <div class="stack">
            <button type="button" class="button" id="passkey-button">Sign in with a passkey</button>
            <p class="field-error" id="passkey-error" hidden></p>
        </div>

        <p class="muted">
            <a href="/forgot-password">Forgotten your password?</a>
            {% if registration_allowed %}
                · <a href="/register">Create an account</a>
            {% endif %}
        </p>
    </section>

    <script src="/assets/webauthn.js" defer></script>
    <script type="module">
        window.renovoWebAuthn.bindAuthentication({
            button: document.getElementById('passkey-button'),
            error: document.getElementById('passkey-error'),
            optionsUrl: '/login/passkey/options',
            verifyUrl: '/login/passkey?next={{ next|url_encode }}',
            csrf: '{{ csrf_token() }}',
        });
    </script>
{% endblock %}
