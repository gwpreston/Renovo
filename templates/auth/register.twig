{% extends 'auth/_layout.twig' %}

{% set card_icon = 'user-add' %}

{% block card_title %}{{ t('auth_register.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_register.intro') }}{% endblock %}

{% block card_body %}
    {% include 'partials/errors.twig' %}

    <form method="post" action="/register" class="auth-form">
        {{ csrf_field() }}

        {% include 'auth/_input.twig' with {
            'id': 'display_name',
            'name': 'display_name',
            'label': t('field.your_name'),
            'value': values.display_name|default(''),
            'autocomplete': 'name',
            'error': errors.display_name|default(null),
            'required': true,
            'autofocus': true,
        } only %}

        {% include 'auth/_input.twig' with {
            'id': 'email',
            'name': 'email',
            'type': 'email',
            'label': t('field.email'),
            'value': values.email|default(''),
            'autocomplete': 'username',
            'placeholder': t('auth.email_placeholder'),
            'error': errors.email|default(null),
            'required': true,
        } only %}

        {% include 'auth/_new_password.twig' with {
            'label': t('field.password'),
            'confirm_label': t('field.confirm_password'),
            'errors': errors,
        } only %}

        <button type="submit" class="button button-primary auth-submit">{{ t('auth_register.create_account') }}</button>
    </form>
{% endblock %}

{% block card_after %}
    <p class="auth-foot">
        {{ t('auth_register.already_have_an_account') }}
        <a href="/login">{{ t('auth_login.title') }}</a>
    </p>
{% endblock %}
