{% extends 'layout.twig' %}

{% block title %}{{ t('auth_two_factor.title') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>{{ t('auth_two_factor.title') }}</h1>
        <p class="muted">{{ t('auth_two_factor.greeting', {'name': display_name}) }}</p>

        {% if methods.passkey %}
            <div class="stack" id="passkey-block">
                <button type="button" class="button" id="passkey-button">
                    {{ t('auth_two_factor.passkey') }}
                </button>
                <p class="field-error" id="passkey-error" hidden></p>
            </div>

            {% if methods.totp %}<hr class="divider">{% endif %}
        {% endif %}

        {% if methods.totp %}
            <form method="post" action="/login/two-factor" class="stack">
                {{ csrf_field() }}

                <label for="code">{{ t('auth_two_factor.code_label') }}</label>
                <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
                       pattern="[0-9]{6}" maxlength="6" required autofocus>
                {% if errors.code is defined %}<p class="field-error">{{ error_message(errors.code) }}</p>{% endif %}

                <button type="submit" class="button button-primary">{{ t('auth_two_factor.verify') }}</button>
            </form>

        {% elseif not methods.passkey %}
            <p class="field-error">
                {{ t('auth_two_factor.no_factor') }}
            </p>
        {% endif %}

        {#
            Offered whichever factor is set up: losing the only registered
            passkey is exactly as locking-out as losing the authenticator.
        #}
        {% if methods.recovery %}
            <details class="stack">
                <summary>{{ t('auth_two_factor.recovery_toggle') }}</summary>

                <form method="post" action="/login/two-factor" class="stack">
                    {{ csrf_field() }}
                    <input type="hidden" name="mode" value="recovery">

                    <label for="recovery-code">{{ t('auth_two_factor.recovery_code') }}</label>
                    <input type="text" id="recovery-code" name="code" autocomplete="off" required>

                    <button type="submit" class="button">{{ t('auth_two_factor.use_recovery_code') }}</button>
                </form>
            </details>
        {% endif %}

        <form method="post" action="/login/two-factor/cancel" class="inline">
            {{ csrf_field() }}
            <button type="submit" class="button button-quiet">{{ t('auth_two_factor.cancel') }}</button>
        </form>
    </section>

    {% if methods.passkey %}
        <script src="{{ asset('/assets/webauthn.js') }}" defer></script>
        <script type="module">
            document.addEventListener('DOMContentLoaded', () => {
                window.renovoWebAuthn.bindAuthentication({
                    button: document.getElementById('passkey-button'),
                    error: document.getElementById('passkey-error'),
                    optionsUrl: '/login/two-factor/passkey/options',
                    verifyUrl: '/login/two-factor/passkey',
                    csrf: '{{ csrf_token() }}',
                });
            });
        </script>
    {% endif %}
{% endblock %}
