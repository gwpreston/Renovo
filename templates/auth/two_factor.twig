{% extends 'layout.twig' %}

{% block title %}Two-step verification — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>Two-step verification</h1>
        <p class="muted">Hello {{ display_name }} — one more step to finish signing in.</p>

        {% if methods.passkey %}
            <div class="stack" id="passkey-block">
                <button type="button" class="button button-primary" id="passkey-button">
                    Use a passkey or security key
                </button>
                <p class="field-error" id="passkey-error" hidden></p>
            </div>

            {% if methods.totp %}<hr class="divider">{% endif %}
        {% endif %}

        {% if methods.totp %}
            <form method="post" action="/login/two-factor" class="stack">
                {{ csrf_field() }}

                <label for="code">Code from your authenticator app</label>
                <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
                       pattern="[0-9]{6}" maxlength="6" required autofocus>
                {% if errors.code is defined %}<p class="field-error">{{ errors.code }}</p>{% endif %}

                <button type="submit" class="button button-primary">Verify</button>
            </form>

        {% elseif not methods.passkey %}
            <p class="field-error">
                This account has no second factor available. Ask an administrator for help.
            </p>
        {% endif %}

        {#
            Offered whichever factor is set up: losing the only registered
            passkey is exactly as locking-out as losing the authenticator.
        #}
        {% if methods.recovery %}
            <details class="stack">
                <summary>Lost your device? Use a recovery code</summary>

                <form method="post" action="/login/two-factor" class="stack">
                    {{ csrf_field() }}
                    <input type="hidden" name="mode" value="recovery">

                    <label for="recovery-code">Recovery code</label>
                    <input type="text" id="recovery-code" name="code" autocomplete="off" required>

                    <button type="submit" class="button">Use recovery code</button>
                </form>
            </details>
        {% endif %}

        <form method="post" action="/login/two-factor/cancel" class="inline">
            {{ csrf_field() }}
            <button type="submit" class="button button-quiet">Cancel and sign in as someone else</button>
        </form>
    </section>

    {% if methods.passkey %}
        <script src="/assets/webauthn.js" defer></script>
        <script type="module">
            document.addEventListener('DOMContentLoaded', () => {
                window.renovoWebAuthn.bindAuthentication({
                    button: document.getElementById('passkey-button'),
                    error: document.getElementById('passkey-error'),
                    optionsUrl: '/login/two-factor/passkey/options',
                    verifyUrl: '/login/two-factor/passkey',
                    csrf: '{{ csrf_token() }}',
                });
            });
        </script>
    {% endif %}
{% endblock %}
