{% extends 'auth/_layout.twig' %}

{#
    Ask for a reset link. The lifetime is the token's own, read from
    PasswordResetService — never typed here — so the page cannot promise an
    hour the link does not have.
#}

{% set card_icon = 'lock-reset' %}

{% block card_title %}{{ t('auth_forgot_password.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_forgot_password.intro', {'minutes': minutes}) }}{% endblock %}

{% block card_body %}
    {% if errors.email is defined %}
        {% include 'auth/_alert.twig' with {'message': error_message(errors.email)} only %}
    {% endif %}

    <form method="post" action="/forgot-password" class="auth-form">
        {{ csrf_field() }}

        {% include 'auth/_input.twig' with {
            'id': 'email',
            'name': 'email',
            'type': 'email',
            'label': t('field.email'),
            'value': values.email|default(''),
            'autocomplete': 'username',
            'placeholder': t('auth.email_placeholder'),
            'required': true,
            'autofocus': true,
        } only %}

        <button type="submit" class="button button-primary auth-submit">{{ t('auth_forgot_password.send_reset_link') }}</button>
    </form>

    <p class="auth-links"><a class="auth-back" href="/login">← {{ t('action.back_to_sign_in') }}</a></p>
{% endblock %}
