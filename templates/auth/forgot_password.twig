{% extends 'layout.twig' %}

{% block title %}Reset your password — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>Reset your password</h1>
        <p class="muted">Enter your email address and we will send you a link to set a new password.</p>

        <form method="post" action="/forgot-password" class="stack">
            {{ csrf_field() }}

            <label for="email">Email address</label>
            <input type="email" id="email" name="email" value="{{ values.email|default('') }}"
                   autocomplete="username" required autofocus>
            {% if errors.email is defined %}<p class="field-error">{{ errors.email }}</p>{% endif %}

            <button type="submit" class="button button-primary">Send reset link</button>
        </form>

        <p class="muted"><a href="/login">Back to sign in</a></p>
    </section>
{% endblock %}
