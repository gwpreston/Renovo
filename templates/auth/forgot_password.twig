{% extends 'layout.twig' %}

{% block title %}{{ t('auth_forgot_password.title') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>{{ t('auth_forgot_password.title') }}</h1>
        <p class="muted">{{ t('auth_forgot_password.intro') }}</p>

        <form method="post" action="/forgot-password" class="stack">
            {{ csrf_field() }}

            <label for="email">{{ t('field.email') }}</label>
            <input type="email" id="email" name="email" value="{{ values.email|default('') }}"
                   autocomplete="username" required autofocus>
            {% if errors.email is defined %}<p class="field-error">{{ error_message(errors.email) }}</p>{% endif %}

            <button type="submit" class="button button-primary">{{ t('auth_forgot_password.send_reset_link') }}</button>
        </form>

        <p class="muted"><a href="/login">{{ t('action.back_to_sign_in') }}</a></p>
    </section>
{% endblock %}
