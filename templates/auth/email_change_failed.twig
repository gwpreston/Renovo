{% extends 'layout.twig' %}

{% block title %}{{ t('auth.link_expired') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>{{ t('auth_email_change_failed.title') }}</h1>
        <p class="muted">{{ t('auth_email_change_failed.intro') }}</p>

        {% for error in errors %}
            <p class="field-error">{{ error_message(error) }}</p>
        {% endfor %}

        <p><a class="button" href="/profile/account">{{ t('auth_email_change_failed.back') }}</a></p>
    </section>
{% endblock %}
