{% extends 'auth/_layout.twig' %}

{% set card_icon = 'clock' %}

{% block card_title %}{{ t('auth_email_change_failed.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_email_change_failed.intro') }}{% endblock %}

{% block card_body %}
    {% for error in errors %}
        {% include 'auth/_alert.twig' with {'message': error_message(error)} only %}
    {% endfor %}

    {% set signed_in = signed_in|default(false) %}
    <a class="button button-primary auth-submit" href="{{ signed_in ? '/profile' : '/login' }}">
        {{- signed_in ? t('auth_email_change_failed.back') : t('auth_login.title') -}}
    </a>
{% endblock %}
