{% extends 'layout.twig' %}

{% block title %}Check your inbox — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>Check your inbox</h1>
        {#
            Shown whether or not the address is registered, so the form cannot
            be used to work out which addresses have accounts.
        #}
        <p>If that address has an account, a reset link is on its way. It is valid for one hour.</p>
        <p><a class="button" href="/login">Back to sign in</a></p>
    </section>
{% endblock %}
