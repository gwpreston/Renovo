{% extends 'auth/_layout.twig' %}

{#
    Shown whether or not the address is registered — and word for word the
    same either way — so the form cannot be used to work out which addresses
    have accounts. "Send again" is the same form posted again, under the same
    rate limit.
#}

{% set card_icon = 'mail-sent' %}

{% block card_title %}{{ t('auth_forgot_password_sent.title') }}{% endblock %}
{% block card_intro %}{{ t('auth_forgot_password_sent.intro', {'email': email, 'minutes': minutes}) }}{% endblock %}

{% block card_body %}
    <p class="auth-note">{{ t('auth_forgot_password_sent.nothing_arrived') }}</p>

    <div class="auth-actions">
        <form method="post" action="/forgot-password">
            {{ csrf_field() }}
            <input type="hidden" name="email" value="{{ email }}">
            <button type="submit" class="button auth-submit">{{ t('auth_forgot_password_sent.send_again') }}</button>
        </form>
        <a class="button button-secondary auth-submit" href="/login">{{ t('action.back_to_sign_in') }}</a>
    </div>
{% endblock %}
