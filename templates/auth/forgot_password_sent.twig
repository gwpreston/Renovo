{% extends 'layout.twig' %}

{% block title %}{{ t('auth_forgot_password_sent.title') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>{{ t('auth_forgot_password_sent.title') }}</h1>
        {#
            Shown whether or not the address is registered, so the form cannot
            be used to work out which addresses have accounts.
        #}
        <p>{{ t('auth_forgot_password_sent.intro') }}</p>
        <p><a class="button" href="/login">{{ t('action.back_to_sign_in') }}</a></p>
    </section>
{% endblock %}
