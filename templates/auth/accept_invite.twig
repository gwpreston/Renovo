{% extends 'auth/_layout.twig' %}

{#
    The one signed-out page that names a household. The link was sent to this
    person, and the email that carried it named the household already, so the
    name tells them nothing they were not told; anywhere else before sign-in
    it would be a disclosure.

    No email field. The person reading this followed a link that was sent to
    their address, which proves they can read mail there far better than
    typing it would.
#}

{% set card_icon = 'household' %}

{% block card_title %}{{ t('auth_invite.title') }}{% endblock %}
{% block card_intro %}
    {{- household ? t('auth_invite.intro_named', {'household': household}) : t('auth_invite.intro') -}}
{% endblock %}

{% block card_body %}
    {% include 'partials/errors.twig' %}

    <form method="post" action="/accept-invite" class="auth-form">
        {{ csrf_field() }}
        <input type="hidden" name="token" value="{{ token }}">

        {% include 'auth/_new_password.twig' with {
            'label': t('auth_invite.choose_password'),
            'confirm_label': t('auth_invite.confirm_password'),
            'errors': errors,
            'autofocus': true,
        } only %}

        <button type="submit" class="button button-primary auth-submit">{{ t('auth_invite.join') }}</button>
    </form>
{% endblock %}
