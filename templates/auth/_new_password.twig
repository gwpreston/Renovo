{#
    A new password, its meter, and the confirmation.

    The meter is a hint drawn from the server's rule, not a second rule. Its
    thresholds come from AuthService::passwordMeterRules(), the same class
    whose validatePassword() decides; the caption states that minimum, so
    it cannot promise twelve characters while the server asks for ten. Without
    script the caption is all there is, and the server's message is the answer.

    label, confirm_label   required
    errors                 the form's errors; `password` and `password_confirm` are read
    autofocus              on the first field
    id_prefix              when a page has more than one (defaults to none)
#}
{% set rules = password_rules() %}
{% set prefix = id_prefix|default('') %}
{% set confirm_error = errors.password_confirm is defined ? error_message(errors.password_confirm) : '' %}

{% include 'auth/_password.twig' with {
    'id': prefix ~ 'password',
    'name': 'password',
    'label': label,
    'autocomplete': 'new-password',
    'error': errors.password|default(null),
    'autofocus': autofocus|default(false),
    'describedby': prefix ~ 'password-meter',
} only %}

<div class="password-meter" id="{{ prefix }}password-meter" data-password-meter data-for="{{ prefix }}password"
     data-min="{{ rules.min }}" data-long="{{ rules.long }}"
     data-labels="{{ [
        t('auth.meter.too_short'),
        t('auth.meter.weak'),
        t('auth.meter.fair'),
        t('auth.meter.good'),
        t('auth.meter.strong')
     ]|json_encode }}">
    <div class="password-meter-bars" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
    </div>
    <p class="password-meter-caption">
        <span class="password-meter-label" data-meter-label aria-live="polite"></span>
        <span>{{ t('auth.meter.minimum', {'count': rules.min}) }}</span>
    </p>
</div>

<div class="auth-field">
    <label for="{{ prefix }}password_confirm">{{ confirm_label }}</label>
    <input type="password" id="{{ prefix }}password_confirm" name="password_confirm" autocomplete="new-password"
           data-confirms="{{ prefix }}password"
           aria-describedby="{{ prefix }}password_confirm-error"
           {% if confirm_error %}aria-invalid="true"{% endif %} required>
    <p class="field-error" id="{{ prefix }}password_confirm-error" data-mismatch
       data-message="{{ t('error.password.mismatch') }}" {{ confirm_error ? '' : 'hidden' }}>{{ confirm_error }}</p>
</div>
