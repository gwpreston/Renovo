{#
    What the month on screen amounts to.

    Three observations, each a plain reading of the grid beside it rather than
    a prediction: what it costs, which free trials stop being free, and what
    can still be cancelled before it charges. Nothing here is derived from
    anything the member cannot already see on this page.

    A section with nothing to say is not rendered. An empty card headed
    "Calendar insight" holds a gap open and tells the reader less than the grid
    does on its own — and the grid says "nothing due this month" itself, where
    a reader on a phone will actually see it.

    A month can be empty of charges and still hold a deadline: a long notice
    period puts the last day to cancel in a month before the charge it avoids.
    That is exactly the case worth showing, so the card's condition is not
    simply "does this month cost anything".
#}
{% import 'partials/logo.twig' as logo %}

{% if calendar.count > 0 or calendar.deadlines is not empty %}
<section class="card calendar-insight" aria-labelledby="calendar-insight-heading">
    <h2 id="calendar-insight-heading">{{ t('calendar.insight') }}</h2>

    {#
        The month's total, promoted out of the muted line above the grid. One
        figure per currency and never a sum across them: this instance has no
        rate it is obliged to trust, and adding two currencies would invent one.
    #}
    {% if calendar.count > 0 %}
        <p class="calendar-insight-total">
            {% for currency, amount in calendar.totals %}
                <span class="stat-value num">{{ amount|money(currency) }}</span>{{ not loop.last ? ' ' : '' }}
            {% endfor %}
        </p>
        <p class="muted">{{ t('calendar.due_this_month', {'count': calendar.count}) }}</p>
    {% endif %}

    {% if calendar.trials is not empty %}
        <h3 class="calendar-insight-heading">
            {{ t('calendar.trials_ending', {'count': calendar.trials|length}) }}
        </h3>
        <ul class="renewals">
            {% for trial in calendar.trials %}
                <li>
                    <span class="renewal-name">
                        {{ logo.mark(trial.subscription, 20) }}
                        <a href="/subscriptions/{{ trial.subscription.id }}/money">
                            {{ trial.subscription.name }}
                        </a>
                    </span>
                    <span class="renewal-date num">{{ trial.date|local_date('d MMM') }}</span>
                    <span class="renewal-amount num">
                        {{ trial.amount.amountMinor|money(trial.amount.currency) }}
                    </span>
                </li>
            {% endfor %}
        </ul>
        <p class="muted">
            {% for currency, amount in calendar.trial_totals %}
                {{ amount|money(currency) }}{{ not loop.last ? ' · ' : '' }}
            {% endfor %}
            {{ t('calendar.trials_starting_note') }}
        </p>
    {% endif %}

    {#
        The deadlines. These are the one thing on this page that expires: a
        renewal missed is a bill, a deadline missed is a year of a bill. The
        date shown is the last day notice can be given, and the charge it
        avoids is named beside it so the figure is checkable.
    #}
    {% if calendar.deadlines is not empty %}
        <h3 class="calendar-insight-heading">
            {{ t('calendar.deadlines_this_month', {'count': calendar.deadlines|length}) }}
        </h3>
        <ul class="renewals">
            {% for deadline in calendar.deadlines %}
                <li class="calendar-deadline">
                    <span class="renewal-name">
                        {{ logo.mark(deadline.subscription, 20) }}
                        <a href="/subscriptions/{{ deadline.subscription.id }}/money">
                            {{ deadline.subscription.name }}
                        </a>
                    </span>
                    <span class="renewal-date num">
                        <span class="badge badge-warn">
                            {{ t('calendar.cancel_by', {'date': deadline.date|local_date('d MMM')}) }}
                        </span>
                    </span>
                    <span class="renewal-amount num">
                        {{ deadline.amount.amountMinor|money(deadline.amount.currency) }}
                    </span>
                </li>
            {% endfor %}
        </ul>
        <p class="muted">{{ t('calendar.deadlines_note') }}</p>
    {% endif %}
</section>
{% endif %}
