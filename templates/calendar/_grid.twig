{#
    The grid on its own, so month navigation swaps it through htmx without
    re-rendering the page around it.
#}
<section id="calendar" class="card calendar">
    <header class="calendar-header">
        <h2>{{ calendar.month|local_date('MMMM y') }}</h2>

        <nav class="calendar-nav" aria-label="{{ t('calendar.month_navigation') }}">
            {% set query = mine_only ? '&mine=1' : '' %}

            {% if calendar.previous %}
                <a class="button button-quiet"
                   href="/calendar?month={{ calendar.previous }}{{ query }}"
                   hx-get="/calendar?month={{ calendar.previous }}{{ query }}"
                   hx-target="#calendar" hx-swap="outerHTML" hx-push-url="true"
                   rel="prev">{{ t('calendar.previous_month') }}</a>
            {% endif %}

            {% if calendar.next %}
                <a class="button button-quiet"
                   href="/calendar?month={{ calendar.next }}{{ query }}"
                   hx-get="/calendar?month={{ calendar.next }}{{ query }}"
                   hx-target="#calendar" hx-swap="outerHTML" hx-push-url="true"
                   rel="next">{{ t('calendar.next_month') }}</a>
            {% endif %}
        </nav>
    </header>

    {% if calendar.count == 0 %}
        <p class="muted empty">{{ t('calendar.nothing_due') }}</p>
    {% else %}
        <p class="muted">
            {{ t('calendar.due_this_month', {'count': calendar.count}) }}
            {% for currency, amount in calendar.totals %}
                <strong>{{ amount|money(currency) }}</strong>{{ not loop.last ? ' · ' : '' }}
            {% endfor %}
        </p>
    {% endif %}

    <div class="table-scroll">
        <table class="calendar-grid">
            <caption class="visually-hidden">
                {{ t('calendar.caption', {'month': calendar.month|local_date('MMMM y')}) }}
            </caption>
            <thead>
            <tr>
                {% for weekday in calendar.weekdays %}
                    <th scope="col">
                        <abbr title="{{ weekday|local_date('EEEE') }}">{{ weekday|local_date('EEE') }}</abbr>
                    </th>
                {% endfor %}
            </tr>
            </thead>
            <tbody>
            {% for week in calendar.weeks %}
                <tr>
                    {% for day in week %}
                        {% if day.date is null %}
                            <td class="calendar-day is-empty"></td>
                        {% else %}
                            <td class="calendar-day {{ day.is_today ? 'is-today' : '' }}">
                                <span class="calendar-date">
                                    {{ day.date|local_date('d') }}
                                    {%- if day.is_today %}
                                        <span class="visually-hidden">({{ t('state.today') }})</span>
                                    {%- endif %}
                                </span>

                                {% if day.events %}
                                    <ul class="calendar-events">
                                        {% for event in day.events %}
                                            <li class="calendar-event {{ event.reason == 'trial_conversion'
                                                ? 'is-trial' : '' }}">
                                                <a href="/subscriptions/{{ event.subscription.id }}/money">
                                                    {{ event.subscription.name }}
                                                </a>
                                                <span class="calendar-amount">
                                                    {{ event.amount.amountMinor|money(event.amount.currency) }}
                                                </span>
                                                {% if event.reason == 'trial_conversion' %}
                                                    <span class="badge badge-warning">
                                                        {{ t('state.trial_converts') }}
                                                    </span>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>
                        {% endif %}
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
