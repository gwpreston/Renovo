{% extends 'layout.twig' %}

{% block heading %}{{ t('tokens.title') }}{% endblock %}

{% block content %}
    <p class="muted">
        {{ t('tokens.intro') }}
    </p>

    {% if issued_token %}
        <section class="card callout">
            <h2>{{ t('tokens.your_new_token') }}</h2>
            <p>
                {{ t('tokens.new_token_note') }}
            </p>
            <p><code class="token">{{ issued_token }}</code></p>
        </section>
    {% endif %}

    <section class="card">
        <h2>{{ t('tokens.issue_a_token') }}</h2>

        <form method="post" action="/settings/api-tokens" class="stack">
            {{ csrf_field() }}

            <label for="token-name">{{ t('tokens.what_it_is_for') }}</label>
            <input type="text" id="token-name" name="name" maxlength="100" required
                   placeholder="{{ t('tokens.name_placeholder') }}">

            <label for="token-abilities">{{ t('tokens.what_it_may_do') }}</label>
            <select id="token-abilities" name="abilities">
                {% for ability in abilities %}
                    <option value="{{ ability.value }}">{{ t(ability.labelKey()) }}</option>
                {% endfor %}
            </select>
            <p class="field-hint">
                {{ t('tokens.abilities_hint') }}
            </p>

            <label for="token-expires">{{ t('tokens.expires_optional') }}</label>
            <input type="date" id="token-expires" name="expires_at">

            <button type="submit" class="button button-primary">{{ t('tokens.create_token') }}</button>
        </form>
    </section>

    <section class="card">
        <h2>{{ t('tokens.your_tokens') }}</h2>

        {% if tokens is empty %}
            <p class="muted">{{ t('tokens.none_yet') }}</p>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('field.name') }}</th>
                        <th scope="col">{{ t('tokens.identifier') }}</th>
                        <th scope="col">{{ t('tokens.can') }}</th>
                        <th scope="col">{{ t('field.last_used') }}</th>
                        <th scope="col">{{ t('field.status') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ t('field.actions') }}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for token in tokens %}
                        <tr>
                            <td>{{ token.name }}</td>
                            <td><code>{{ token.publicId }}</code></td>
                            <td>{{ t(token.abilities.labelKey()) }}</td>
                            <td>
                                {%- if token.lastUsedAt -%}
                                    {{ token.lastUsedAt|local_date('d MMM y, HH:mm') }}
                                {%- else -%}
                                    <span class="muted">{{ t('state.never') }}</span>
                                {%- endif -%}
                            </td>
                            <td>
                                {% if token.isRevoked() %}
                                    <span class="pill pill-danger">{{ t('state.revoked') }}</span>
                                {% elseif token.expiresAt and token.expiresAt < date() %}
                                    <span class="pill">{{ t('state.expired') }}</span>
                                {% elseif token.expiresAt %}
                                    {{ t('tokens.expires_on', {'date': token.expiresAt|local_date('d MMM y')}) }}
                                {% else %}
                                    <span class="pill pill-success">{{ t('state.active') }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if not token.isRevoked() %}
                                    <form method="post"
                                          action="/settings/api-tokens/{{ token.id }}/revoke"
                                          class="inline"
                                          onsubmit="return confirm('Revoke this token? Anything using it stops working straight away.')">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-quiet">{{ t('action.revoke') }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <section class="card">
        <h2>{{ t('tokens.using_them') }}</h2>

        <p>{{ t('tokens.bearer_note') }}</p>
        <pre class="code-block">curl -H "Authorization: Bearer rnv_..." \
     {{ feed_url|replace({'/calendar.ics': '/subscriptions'}) }}</pre>

        <p>
            {{ t('tokens.reference_is_at') }}
            <a href="/api/v1/openapi.yaml">/api/v1/openapi.yaml</a>
            (<a href="/api/v1/openapi.json">{{ t('tokens.as_json') }}</a>)
        </p>

        <h3>{{ t('tokens.calendar_feed') }}</h3>
        <p>
            {{ t('tokens.calendar_note') }}
        </p>
        <pre class="code-block">{{ feed_url }}?token=rnv_...</pre>
    </section>
{% endblock %}
