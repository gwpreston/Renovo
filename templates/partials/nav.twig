<header class="nav">
    <div class="container nav-inner">
        <a class="nav-brand" href="/">{{ instance_name }}</a>

        <nav class="nav-links" aria-label="{{ t('nav.primary') }}">
            <a href="/" class="{{ current_path == '/' ? 'is-active' : '' }}">{{ t('nav.dashboard') }}</a>
            <a href="/subscriptions"
               class="{{ current_path starts with '/subscriptions' ? 'is-active' : '' }}">{{ t('field.subscriptions') }}</a>
            <a href="/budgets"
               class="{{ current_path starts with '/budgets' ? 'is-active' : '' }}">{{ t('nav.budgets') }}</a>
            <a href="/forecast"
               class="{{ current_path starts with '/forecast' ? 'is-active' : '' }}">{{ t('nav.forecast') }}</a>
            <a href="/calendar"
               class="{{ current_path starts with '/calendar' ? 'is-active' : '' }}">{{ t('nav.calendar') }}</a>
            <a href="/cancellations"
               class="{{ current_path starts with '/cancellations' ? 'is-active' : '' }}">{{ t('nav.cancellations') }}</a>
            <a href="/stats"
               class="{{ current_path starts with '/stats' ? 'is-active' : '' }}">{{ t('nav.stats') }}</a>
            <a href="/categories"
               class="{{ current_path starts with '/categories' ? 'is-active' : '' }}">{{ t('nav.categories') }}</a>
            <a href="/settings/notifications"
               class="{{ current_path starts with '/settings/notifications' ? 'is-active' : '' }}">{{ t('nav.alerts') }}</a>
            {% if can(scope, 'data.import') %}
                <a href="/import"
                   class="{{ current_path starts with '/import' ? 'is-active' : '' }}">{{ t('nav.import') }}</a>
            {% endif %}
            {% if can(scope, 'audit.view') %}
                <a href="/audit"
                   class="{{ current_path starts with '/audit' ? 'is-active' : '' }}">{{ t('nav.audit') }}</a>
            {% endif %}
            <a href="/settings"
               class="{{ current_path starts with '/settings' and current_path != '/settings/notifications'
                   ? 'is-active' : '' }}">{{ t('nav.settings') }}</a>
        </nav>

        <div class="nav-user">
            <span class="nav-name">{{ current_user.displayName }}</span>
            <form method="post" action="/logout" class="inline">
                {{ csrf_field() }}
                <button type="submit" class="button button-quiet">{{ t('nav.sign_out') }}</button>
            </form>
        </div>
    </div>
</header>
