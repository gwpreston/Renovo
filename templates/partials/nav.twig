<header class="nav">
    <div class="container nav-inner">
        <a class="nav-brand" href="/">{{ instance_name }}</a>

        <nav class="nav-links">
            <a href="/" class="{{ current_path == '/' ? 'is-active' : '' }}">Dashboard</a>
            <a href="/subscriptions"
               class="{{ current_path starts with '/subscriptions' ? 'is-active' : '' }}">Subscriptions</a>
            <a href="/budgets"
               class="{{ current_path starts with '/budgets' ? 'is-active' : '' }}">Budgets</a>
            <a href="/forecast"
               class="{{ current_path starts with '/forecast' ? 'is-active' : '' }}">Forecast</a>
            <a href="/cancellations"
               class="{{ current_path starts with '/cancellations' ? 'is-active' : '' }}">Cancel by</a>
            <a href="/stats"
               class="{{ current_path starts with '/stats' ? 'is-active' : '' }}">Stats</a>
            <a href="/categories"
               class="{{ current_path starts with '/categories' ? 'is-active' : '' }}">Categories</a>
            <a href="/settings/notifications"
               class="{{ current_path starts with '/settings/notifications' ? 'is-active' : '' }}">Alerts</a>
            {% if can(scope, 'data.import') %}
                <a href="/import"
                   class="{{ current_path starts with '/import' ? 'is-active' : '' }}">Import</a>
            {% endif %}
            {% if can(scope, 'audit.view') %}
                <a href="/audit"
                   class="{{ current_path starts with '/audit' ? 'is-active' : '' }}">Audit</a>
            {% endif %}
            <a href="/settings"
               class="{{ current_path starts with '/settings' and current_path != '/settings/notifications'
                   ? 'is-active' : '' }}">Settings</a>
        </nav>

        <div class="nav-user">
            <span class="nav-name">{{ current_user.displayName }}</span>
            <form method="post" action="/logout" class="inline">
                {{ csrf_field() }}
                <button type="submit" class="button button-quiet">Sign out</button>
            </form>
        </div>
    </div>
</header>
