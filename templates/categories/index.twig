{% extends 'layout.twig' %}

{% block title %}Categories and tags — {{ instance_name }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Categories and tags</h1>
    </div>

    <div class="columns">
        <section class="card">
            <h2>Categories</h2>

            {% if categories is empty %}
                <p class="muted">No categories yet.</p>
            {% else %}
                <table class="table">
                    <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>
                                {% if can(scope, 'category.manage') %}
                                    <form method="post" action="/categories/{{ category.id }}" class="inline-form">
                                        {{ csrf_field() }}
                                        <input type="text" name="name" value="{{ category.name }}" aria-label="Category name">
                                        <input type="color" name="colour" value="{{ category.colour|default('#888888') }}"
                                               aria-label="Category colour">
                                        <button type="submit" class="button button-quiet">Save</button>
                                    </form>
                                {% else %}
                                    <span class="swatch" style="background: {{ category.colour|default('#888888') }}"></span>
                                    {{ category.name }}
                                {% endif %}
                            </td>
                            <td class="actions">
                                {% if can(scope, 'category.manage') %}
                                    <form method="post" action="/categories/{{ category.id }}/delete" class="inline"
                                          onsubmit="return confirm('Delete {{ category.name|e('js') }}?')">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-danger">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {% if can(scope, 'category.manage') %}
                <form method="post" action="/categories" class="stack">
                    {{ csrf_field() }}
                    <label for="name">New category</label>
                    <div class="input-group">
                        <input type="text" id="name" name="name" value="{{ values.name|default('') }}" required>
                        <input type="color" name="colour" value="{{ values.colour|default('#4f7df0') }}"
                               aria-label="Colour">
                    </div>
                    {% if errors.name is defined %}<p class="field-error">{{ errors.name }}</p>{% endif %}
                    {% if errors.colour is defined %}<p class="field-error">{{ errors.colour }}</p>{% endif %}
                    <button type="submit" class="button button-primary">Add category</button>
                </form>
            {% endif %}
        </section>

        <section class="card">
            <h2>Tags</h2>
            <p class="muted">Tags are created as you type them on a subscription.</p>

            {% if tags is empty %}
                <p class="muted">No tags yet.</p>
            {% else %}
                <ul class="tag-manage">
                    {% for tag in tags %}
                        <li>
                            <span class="chip chip-static">{{ tag.name }}</span>
                            {% if can(scope, 'tag.manage') %}
                                <form method="post" action="/tags/{{ tag.id }}/delete" class="inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-quiet" aria-label="Delete {{ tag.name }}">
                                        Remove
                                    </button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
