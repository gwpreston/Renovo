{% extends 'layout.twig' %}

{% block title %}{{ t('categories.title') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>{{ t('categories.title') }}</h1>
    </div>

    <div class="columns">
        <section class="card">
            <h2>{{ t('nav.categories') }}</h2>

            {% if categories is empty %}
                <p class="muted">{{ t('categories.no_categories_yet') }}</p>
            {% else %}
                <table class="table">
                    <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>
                                {% if can(scope, 'category.manage') %}
                                    <form method="post" action="/categories/{{ category.id }}" class="inline-form">
                                        {{ csrf_field() }}
                                        <input type="text" name="name" value="{{ category.name }}" aria-label="{{ t('categories.category_name') }}">
                                        <input type="color" name="colour" value="{{ category.colour|default('#888888') }}"
                                               aria-label="{{ t('categories.category_colour') }}">
                                        <button type="submit" class="button button-quiet">{{ t('action.save') }}</button>
                                    </form>
                                {% else %}
                                    <span class="swatch" style="background: {{ category.colour|default('#888888') }}"></span>
                                    {{ category.name }}
                                {% endif %}
                            </td>
                            <td class="actions">
                                {% if can(scope, 'category.manage') %}
                                    <form method="post" action="/categories/{{ category.id }}/delete" class="inline"
                                          onsubmit="return confirm('Delete {{ category.name|e('js') }}?')">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-danger">{{ t('action.delete') }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {% if can(scope, 'category.manage') %}
                <form method="post" action="/categories" class="stack">
                    {{ csrf_field() }}
                    <label for="name">{{ t('categories.new_category') }}</label>
                    <div class="input-group">
                        <input type="text" id="name" name="name" value="{{ values.name|default('') }}" required>
                        <input type="color" name="colour" value="{{ values.colour|default('#4f7df0') }}"
                               aria-label="{{ t('categories.colour') }}">
                    </div>
                    {% if errors.name is defined %}<p class="field-error">{{ error_message(errors.name) }}</p>{% endif %}
                    {% if errors.colour is defined %}<p class="field-error">{{ error_message(errors.colour) }}</p>{% endif %}
                    <button type="submit" class="button button-primary">{{ t('categories.add_category') }}</button>
                </form>
            {% endif %}
        </section>

        <section class="card">
            <h2>{{ t('field.tags') }}</h2>
            <p class="muted">{{ t('categories.tags_intro') }}</p>

            {% if tags is empty %}
                <p class="muted">{{ t('categories.no_tags_yet') }}</p>
            {% else %}
                <ul class="tag-manage">
                    {% for tag in tags %}
                        <li>
                            <span class="chip chip-static">{{ tag.name }}</span>
                            {% if can(scope, 'tag.manage') %}
                                <form method="post" action="/tags/{{ tag.id }}/delete" class="inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-quiet" aria-label="Delete {{ tag.name }}">
                                        {{ t('action.remove') }}
                                    </button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
