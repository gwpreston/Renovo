{% extends 'layout.twig' %}

{% block title %}Set up notifications — {{ instance_name }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Where should reminders go?</h1>
    </div>

    <p class="muted note">
        Step 2 of 2. Renovo will tell you before a subscription renews, before a free trial starts charging,
        before a cancellation deadline passes, and when a budget is heading over. Add somewhere for it to send
        that — and send yourself a test message, because a token that looks right and is not is the sort of
        thing you want to find out now rather than the week you miss a renewal.
    </p>

    <p class="muted note">
        Mail goes out through <code>{{ smtp_host }}</code>, from <code>{{ mail_from }}</code>. Those come from
        the environment (<code>SMTP_HOST</code>, <code>SMTP_PORT</code>, <code>MAIL_FROM_ADDRESS</code>) and are
        not set here — an instance secret belongs in the environment, not in the database. Add an Email channel
        below and send a test to confirm the relay actually works.
    </p>

    <p class="muted note">
        You can add more channels, or change any of this, later under Settings → Notifications. Every member
        configures their own.
    </p>

    {% if channels is not empty %}
        <section class="card">
            <h2>Configured</h2>
            <ul class="channel-list">
                {% for channel in channels %}
                    <li class="channel">
                        <div>
                            <strong>{{ channel.label }}</strong>
                            <span class="muted">{{ channel_description(channel) }}</span>
                            {% if channel.lastError %}
                                <p class="field-error">Last attempt failed: {{ channel.lastError }}</p>
                            {% elseif channel.lastSuccessAt %}
                                <p class="hint">Test message delivered.</p>
                            {% endif %}
                        </div>
                        <div class="channel-actions">
                            <form method="post" action="/settings/notifications/channels/{{ channel.id }}/test"
                                  class="inline">
                                {{ csrf_field() }}
                                <input type="hidden" name="return_to" value="/setup/notifications">
                                <button type="submit" class="button button-quiet">Send test</button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="card">
        <h2>Add a channel</h2>

        {% for notifier in notifiers %}
            <details class="channel-form" {{ submitted.channel_type is defined
                and submitted.channel_type == notifier.key ? 'open' : '' }}>
                <summary>{{ notifier.label }}</summary>

                <form method="post" action="/setup/notifications/channels" class="stack">
                    {{ csrf_field() }}
                    <input type="hidden" name="channel_type" value="{{ notifier.key }}">

                    <label for="{{ notifier.key }}_label">Name</label>
                    <input type="text" id="{{ notifier.key }}_label" name="label"
                           placeholder="{{ notifier.label }}">

                    {% for field in notifier.fields %}
                        <label for="{{ notifier.key }}_{{ field.name }}">{{ field.label }}</label>
                        <input type="{{ field.type }}"
                               id="{{ notifier.key }}_{{ field.name }}"
                               name="{{ field.name }}"
                               {{ field.required ? 'required' : '' }}
                               autocomplete="off">
                        {% if field.hint %}<p class="hint">{{ field.hint }}</p>{% endif %}
                        {% if errors[field.name] is defined %}
                            <p class="field-error">{{ errors[field.name] }}</p>
                        {% endif %}
                    {% endfor %}

                    <button type="submit" class="button button-primary">Add {{ notifier.label }}</button>
                </form>
            </details>
        {% endfor %}
    </section>

    <form method="post" action="/setup/notifications/finish" class="stack">
        {{ csrf_field() }}
        <button type="submit" class="button button-primary">
            {{ channels is empty ? 'Skip for now' : 'Finish' }}
        </button>
    </form>
{% endblock %}
