{% extends 'layout.twig' %}

{% block title %}{{ t('setup_notifications.title') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>{{ t('setup_notifications.where_should_reminders_go') }}</h1>
    </div>

    <p class="muted note">
        {{ t('setup_notifications.intro') }}
    </p>

    <p class="muted note">
        {{ t('setup_notifications.mail_relay', {'host': smtp_host, 'from': mail_from}) }}
        <code>SMTP_HOST</code>, <code>SMTP_PORT</code>, <code>MAIL_FROM_ADDRESS</code>.
        {{ t('setup_notifications.mail_relay_env') }}
    </p>

    <p class="muted note">
        {{ t('setup_notifications.later_note') }}
    </p>

    {% if channels is not empty %}
        <section class="card">
            <h2>{{ t('setup_notifications.configured') }}</h2>
            <ul class="channel-list">
                {% for channel in channels %}
                    <li class="channel">
                        <div>
                            <strong>{{ channel.label }}</strong>
                            <span class="muted">{{ channel_description(channel) }}</span>
                            {% if channel.lastError %}
                                <p class="field-error">{{ t('notifications.last_error', {'reason': channel.lastError}) }}</p>
                            {% elseif channel.lastSuccessAt %}
                                <p class="hint">{{ t('setup_notifications.test_message_delivered') }}</p>
                            {% endif %}
                        </div>
                        <div class="channel-actions">
                            <form method="post" action="/settings/notifications/channels/{{ channel.id }}/test"
                                  class="inline">
                                {{ csrf_field() }}
                                <input type="hidden" name="return_to" value="/setup/notifications">
                                <button type="submit" class="button button-quiet">{{ t('action.send_test') }}</button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="card">
        <h2>{{ t('notifications.add_a_channel') }}</h2>

        {% for notifier in notifiers %}
            <details class="channel-form" {{ submitted.channel_type is defined
                and submitted.channel_type == notifier.key ? 'open' : '' }}>
                <summary>{{ notifier.label }}</summary>

                <form method="post" action="/setup/notifications/channels" class="stack">
                    {{ csrf_field() }}
                    <input type="hidden" name="channel_type" value="{{ notifier.key }}">

                    <label for="{{ notifier.key }}_label">{{ t('field.name') }}</label>
                    <input type="text" id="{{ notifier.key }}_label" name="label"
                           placeholder="{{ notifier.label }}">

                    {% for field in notifier.fields %}
                        <label for="{{ notifier.key }}_{{ field.name }}">{{ t(field.label) }}</label>
                        <input type="{{ field.type }}"
                               id="{{ notifier.key }}_{{ field.name }}"
                               name="{{ field.name }}"
                               {{ field.required ? 'required' : '' }}
                               autocomplete="off">
                        {% if field.hint %}<p class="hint">{{ t(field.hint) }}</p>{% endif %}
                        {% if errors[field.name] is defined %}
                            <p class="field-error">{{ errors[field.name] }}</p>
                        {% endif %}
                    {% endfor %}

                    <button type="submit" class="button">
                        {{ t('notifications.add_channel_of_type', {'type': notifier.label}) }}
                    </button>
                </form>
            </details>
        {% endfor %}
    </section>

    <form method="post" action="/setup/notifications/finish" class="stack">
        {{ csrf_field() }}
        <button type="submit" class="button button-primary">
            {{ channels is empty
                ? t('setup_notifications.skip_for_now')
                : t('setup_notifications.finish') }}
        </button>
    </form>
{% endblock %}
