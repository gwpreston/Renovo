{% extends 'auth/_layout.twig' %}

{#
    Step one of three: the owner account.

    The only step before anybody is signed in, and the only one that creates
    an account — pre-verified, since there is nobody yet to send a
    confirmation to. Submitting it signs the owner in and moves on to the
    household; the steps after this one run as them.

    No "Sign in instead": until this form has been submitted, every request
    is sent here anyway, so there is nothing to sign in to.
#}

{% block title %}{{ t('setup_wizard.title', {'instance': instance_name}) }}{% endblock %}

{% block card_top %}{% include 'setup/_progress.twig' with {'step': 1} only %}{% endblock %}
{% block card_title %}{{ t('setup_wizard.create_owner') }}{% endblock %}
{% block card_intro %}{{ t('setup_wizard.create_owner_intro') }}{% endblock %}

{% block card_body %}
    {% include 'partials/errors.twig' %}

    <form method="post" action="/setup" class="auth-form">
        {{ csrf_field() }}

        {% include 'auth/_input.twig' with {
            'id': 'display_name',
            'name': 'display_name',
            'label': t('field.your_name'),
            'value': values.display_name|default(''),
            'autocomplete': 'name',
            'error': errors.display_name|default(null),
            'required': true,
            'autofocus': true,
        } only %}

        {% include 'auth/_input.twig' with {
            'id': 'email',
            'name': 'email',
            'type': 'email',
            'label': t('field.email'),
            'value': values.email|default(''),
            'autocomplete': 'username',
            'error': errors.email|default(null),
            'required': true,
        } only %}

        {% include 'auth/_new_password.twig' with {
            'label': t('field.password'),
            'confirm_label': t('field.confirm_password'),
            'errors': errors,
        } only %}

        <div class="wizard-nav">
            <button type="submit" class="button button-primary auth-submit">{{ t('action.continue') }}</button>
        </div>
    </form>
{% endblock %}
