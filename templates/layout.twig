<!DOCTYPE html>
<html lang="{{ locale_tag() }}"
      data-theme="{{ current_user.theme|default('system') }}"
      data-density="{{ current_user.density|default('comfortable') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ instance_name }}{% endblock %}</title>
    {#
        Two stylesheets and two kinds of URL, deliberately.

        `bundle()` looks a name up in the asset build's manifest and prints the
        content-hashed file the build produced — Tailwind's theme and
        utilities, and the @font-face rules for the vendored Inter. `asset()`
        stamps a modification time onto a file that is served as written: the
        hand-written stylesheet, the vendored htmx, the keyboard shortcuts.
        Both answer the same question — what URL will a returning browser
        treat as new after an upgrade — for files that are produced two
        different ways.

        The built stylesheet comes first so the hand-written one, whose rules
        are unlayered and therefore beat anything in Tailwind's layers anyway,
        reads in the order it wins in.

        Every one of these URLs is served by this instance. Nothing on this
        page comes from a third-party host, and `assets:offline-check` fails
        the build if that stops being true.
    #}
    <link rel="stylesheet" href="{{ bundle('app.css') }}">
    <link rel="stylesheet" href="{{ asset('/assets/app.css') }}">
    <script src="{{ asset('/assets/htmx.min.js') }}" defer></script>
    <script src="{{ asset('/assets/app.js') }}" defer></script>
    {# A module, so it is deferred already; `defer` on one is ignored. #}
    <script src="{{ bundle('app.js') }}" type="module"></script>
</head>
{#
    The CSRF token rides on every htmx request via hx-headers, so a fragment
    swap does not need a hidden field of its own.
#}
<body hx-headers='{"X-CSRF-Token": "{{ csrf_token() }}"}'>
{#
    The strings this page's JavaScript needs, from the same catalogue the
    server reads — see AppExtension::jsTranslations(). Rendered as JSON in a
    non-executing script tag rather than assigned in code, so a message
    containing a quote or a bracket cannot end up being parsed as JavaScript.
#}
<script id="renovo-messages" type="application/json">{{ js_translations()|raw }}</script>
<script>
    window.renovoI18n = (function () {
        var messages = {};

        try {
            messages = JSON.parse(document.getElementById('renovo-messages').textContent);
        } catch (error) {
            messages = {};
        }

        return {
            /* Named arguments only: the browser-side strings take no plurals. */
            t: function (key, params) {
                var message = messages[key] || key;

                if (params) {
                    Object.keys(params).forEach(function (name) {
                        message = message.split('{' + name + '}').join(params[name]);
                    });
                }

                return message;
            }
        };
    }());
</script>

<a class="skip-link" href="#main">{{ t('nav.skip_to_content') }}</a>

{% if current_user %}
    {% include 'partials/nav.twig' %}
{% endif %}

<main class="container" id="main" tabindex="-1">
    {% include 'partials/flashes.twig' %}
    {% block content %}{% endblock %}
</main>

<footer class="container footer">
    <span>{{ instance_name }}</span>
    {% if current_user %}
        <button type="button" class="button-link" data-opens-dialog="shortcut-help">
            {{ t('shortcuts.title') }}
        </button>
    {% endif %}
</footer>

{% if current_user %}
    {% include 'partials/dialogs.twig' %}
{% endif %}
</body>
</html>
