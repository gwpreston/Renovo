{#
    The list fragment. Rendered on its own for htmx filter, sort and page
    requests, and included by the full page for a normal load, so the two can
    never drift apart.
#}
{% import 'partials/logo.twig' as logo %}
{% import 'partials/payment_method.twig' as payment_method %}
{% import 'partials/avatar.twig' as avatar %}
{% import _self as list %}

{#
    There is no bulk bar on this screen and so no form around the table: the
    row checkboxes went with the "with selected" controls, because a checkbox
    that posts nowhere is worse than no checkbox. The endpoint, the service
    behind it and its permission are untouched; what went is the screen that
    drove them.
#}
<section id="subscription-list" class="card">
    {% if subscriptions is empty %}
        <p class="muted empty">
            {% if filter.hasActiveFilters %}
                {{ t('subscriptions_list.no_matches') }}
            {% else %}
                {{ t('subscriptions_list.empty') }}
                {% if can(scope, 'subscription.create') %}
                    <a href="/subscriptions/new">{{ t('subscriptions_list.add_the_first_one') }}</a>
                {% endif %}
            {% endif %}
        </p>
    {% else %}
        <div class="table-scroll">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">{{ list.sort_link('name', t('field.name'), filter) }}</th>
                    <th scope="col">{{ t('field.category') }}</th>
                    <th scope="col">{{ t('field.member') }}</th>
                    <th scope="col">{{ t('field.cycle') }}</th>
                    <th scope="col">{{ list.sort_link('next_payment', t('field.next_charge'), filter) }}</th>
                    <th scope="col" class="numeric">{{ list.sort_link('price', t('field.price'), filter) }}</th>
                    <th scope="col" class="numeric">{{ t('field.per_month') }}</th>
                    <th scope="col"><span class="visually-hidden">{{ t('field.actions') }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for subscription in subscriptions %}
                    <tr class="{{ subscription.isActive ? '' : 'is-paused' }}">
                        <td>
                            <div class="cell-name">
                                {{ logo.mark(subscription) }}
                                <div>
                                    {#
                                        A row you may change opens for changing;
                                        one you may only read opens at its costs,
                                        which is the read-only view of it. The
                                        name stays a link either way — a list
                                        where some names lead somewhere and
                                        others do not reads as a fault.
                                    #}
                                    <a href="/subscriptions/{{ subscription.id }}{{
                                        can_edit_row(scope, subscription) ? '/edit' : '/money'
                                    }}">{{ subscription.name }}</a>
                                    {% if subscription.plan %}<span class="muted">{{ subscription.plan }}</span>{% endif %}
                                    {# The status, derived in one place: Cancelled, Paused, Trial, or nothing for Active. #}
                                    {% set status = subscription.status.value %}
                                    {% if status == 'trial' %}
                                        <span class="badge badge-warn">{{ t('state.trial') }}</span>
                                    {% elseif status != 'active' %}
                                        <span class="badge" data-status="{{ status }}">{{ t(subscription.status.labelKey) }}</span>
                                    {% endif %}
                                    {% if subscription.isPrivate %}
                                        <span class="badge" title="{{ t('subscriptions_form.only_me_note') }}">{{ t('visibility.payer') }}</span>
                                    {% endif %}
                                    {% if subscription.splitMode.isSplit %}
                                        <span class="badge"
                                              title="{{ split_label(subscription.splitMode.value) }}">{{ t('state.shared') }}</span>
                                    {% endif %}
                                    {% if subscription.paymentMethodName %}
                                        <div>{{ payment_method.for_subscription(subscription) }}</div>
                                    {% endif %}
                                    {% if subscription.tags %}
                                        <div class="tag-list">
                                            {% for tag in subscription.tags %}
                                                <span class="chip chip-static">{{ tag.name }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ subscription.categoryName ?? '—' }}</td>
                        <td>
                            {% if subscription.ownerName %}
                                <span class="member-identity">
                                    {{ avatar.face(
                                        subscription.ownerUserId,
                                        subscription.ownerName,
                                        subscription.ownerName|initials,
                                        subscription.ownerHasAvatar,
                                        24
                                    ) }}
                                    <span>{{ subscription.ownerName }}</span>
                                </span>
                            {% else %}
                                {{ t('common.none_symbol') }}
                            {% endif %}
                        </td>
                        <td>
                            {{ type_label(subscription.type.value) }}
                            {% if subscription.billingCycle %}
                                · {{ cycle_label(subscription.billingCycle.value, subscription.cycleDays) }}
                            {% endif %}
                        </td>
                        <td>
                            {# For a trial this is the conversion, not the stale payment date. #}
                            {% if subscription.nextChargeDate %}
                                <span class="num">{{ subscription.nextChargeDate|local_date('d MMM y') }}</span>
                                {% if subscription.isTrial %}
                                    <div class="hint">{{ t('state.trial_converts') }}</div>
                                {% endif %}
                                {% set deadline = subscription.cancellationDeadline %}
                                {% if deadline %}
                                    <div class="hint">{{ t('subscriptions_list.cancel_by', {
                                        'date': deadline|local_date('d MMM y'),
                                    }) }}</div>
                                {% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td class="numeric num">{{ subscription.price.amountMinor|money(subscription.price.currency) }}</td>
                        <td class="numeric num">
                            {% if subscription.monthlyMinor is not null %}
                                {{ subscription.monthlyMinor|money(subscription.price.currency) }}
                            {% else %}
                                <span class="muted" title="{{ t('subscriptions_list.not_amortised') }}">—</span>
                            {% endif %}
                        </td>
                        <td class="actions">
                            <a class="button button-quiet"
                               href="/subscriptions/{{ subscription.id }}/money">{{ t('subscriptions_list.cost') }}</a>
                            {% if can(scope, 'subscription.update') and can_edit_row(scope, subscription) %}
                                {% if subscription.isCancelled %}
                                    {# Undoing a cancel lands on Paused, so it cannot restart charges unasked. #}
                                    <form method="post" action="/subscriptions/{{ subscription.id }}/uncancel" class="inline">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-quiet">
                                            {{ t('subscriptions_list.uncancel') }}
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="post" action="/subscriptions/{{ subscription.id }}/toggle" class="inline">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-quiet">
                                            {{ subscription.isActive ? t('subscriptions_list.pause') : t('subscriptions_list.resume') }}
                                        </button>
                                    </form>
                                    <form method="post" action="/subscriptions/{{ subscription.id }}/cancel" class="inline"
                                          onsubmit="return confirm('{{ t('confirm.cancel_subscription', {'name': subscription.name})|e('js') }}')">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-quiet">
                                            {{ subscription.isTrial ? t('subscriptions_list.cancel_trial') : t('subscriptions_list.cancel') }}
                                        </button>
                                    </form>
                                {% endif %}
                            {% endif %}
                            {% if can(scope, 'subscription.delete') and can_edit_row(scope, subscription) %}
                                <form method="post" action="/subscriptions/{{ subscription.id }}/delete" class="inline"
                                      onsubmit="return confirm('{{ t('confirm.delete_subscription', {'name': subscription.name})|e('js') }}')">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-danger">{{ t('action.delete') }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if page_count > 1 %}
            <nav class="pager" aria-label="{{ t('subscriptions_list.pagination') }}">
                {% if filter.page > 1 %}
                    <a class="button button-quiet"
                       href="/subscriptions?{{ filter.toQueryString({'page': filter.page - 1}) }}"
                       hx-get="/subscriptions?{{ filter.toQueryString({'page': filter.page - 1}) }}"
                       hx-target="#subscription-list" hx-select="#subscription-list"
                       hx-swap="outerHTML" hx-push-url="true">{{ t('action.previous') }}</a>
                {% endif %}
                <span class="muted">{{ t('subscriptions_list.pager', {
                    'page': filter.page,
                    'pages': page_count,
                    'total': total,
                }) }}</span>
                {% if filter.page < page_count %}
                    <a class="button button-quiet"
                       href="/subscriptions?{{ filter.toQueryString({'page': filter.page + 1}) }}"
                       hx-get="/subscriptions?{{ filter.toQueryString({'page': filter.page + 1}) }}"
                       hx-target="#subscription-list" hx-select="#subscription-list"
                       hx-swap="outerHTML" hx-push-url="true">{{ t('action.next') }}</a>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
</section>

{#
    The saved-views form's hidden field, refreshed out of band.

    This fragment is what an htmx filter, sort or page request returns, and it
    is all that request returns — the saved-views card above the list is not
    re-rendered. So the field that says "this is the view you are looking at"
    would keep the value the page was first loaded with, and saving a view
    after filtering would store an empty query. It did.

    Sending a replacement alongside the list fixes that at the source: the
    value is still `SubscriptionFilter::toQueryString()`, so what gets saved is
    what the list itself would have written, rather than something the browser
    reconstructed from the address bar.

    Out of band and not part of the swap, because the field lives inside a form
    in the card above and this section is the only thing the list request is
    allowed to replace. htmx applies out-of-band swaps to the whole response
    before `hx-select` narrows it to `#subscription-list`, so the sort and
    pagination links — which do select — carry this too.

    Defaulting to *sending* it is deliberate. Twig here runs with
    `strict_variables` off, so a caller that forgets to pass this flag gets
    whatever the default is and no warning either way. Defaulting to false would
    make that silence reintroduce the stale-field bug — the fragment would
    render without its replacement and nothing would say so. Defaulting to true
    makes the same mistake produce a duplicated id on the full page instead,
    which `PersonalisationTest::savedViewQuery()` asserts against. Both are
    mistakes; only one of them fails a test.

    So the full page — the one place this is included rather than rendered —
    turns it off explicitly, and every other render gets it right by doing
    nothing.

    `??` and not `|default`, which is the trap here: Twig's `default` filter
    substitutes when the value is *empty*, and `false` is empty — so
    `oob_query|default(true)` reads a deliberate `false` as "unset" and helpfully
    turns the field back on. `??` substitutes only for undefined and null, which
    is the question actually being asked.
#}
{% if oob_query ?? true %}
    <input type="hidden" id="saved-view-query" name="query"
           value="{{ current_query }}" hx-swap-oob="true">
{% endif %}

{% macro sort_link(key, label, filter) %}
    {% set direction = (filter.sort == key and filter.direction == 'asc') ? 'desc' : 'asc' %}
    {% set query = filter.toQueryString({'sort': key, 'dir': direction, 'page': null}) %}
    <a href="/subscriptions?{{ query }}"
       hx-get="/subscriptions?{{ query }}"
       hx-target="#subscription-list"
       hx-select="#subscription-list"
       hx-swap="outerHTML"
       hx-push-url="true">
        {{ label }}{% if filter.sort == key %}<span aria-hidden="true">{{ filter.direction == 'asc' ? ' ↑' : ' ↓' }}</span>{% endif %}
    </a>
{% endmacro %}
