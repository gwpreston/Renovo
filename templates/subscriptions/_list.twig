{#
    The list fragment. Rendered on its own for htmx filter, sort and page
    requests, and included by the full page for a normal load, so the two can
    never drift apart.
#}
{% import _self as list %}

{#
    The bulk form wraps the table so a checkbox in any row posts with it. It is
    a plain form rather than an htmx swap: a bulk edit changes rows that may
    drop out of the current filter, so a full reload is the honest response.
#}
<section id="subscription-list" class="card">
{% set can_bulk = can(scope, 'subscription.bulk_edit') %}
{% if can_bulk and subscriptions is not empty %}<form method="post" action="/subscriptions/bulk">{{ csrf_field() }}{% endif %}
    {% if subscriptions is empty %}
        <p class="muted empty">
            {% if filter.hasActiveFilters %}
                Nothing matches those filters.
            {% else %}
                No subscriptions yet.
                {% if can(scope, 'subscription.create') %}
                    <a href="/subscriptions/new">Add the first one.</a>
                {% endif %}
            {% endif %}
        </p>
    {% else %}
        <div class="table-scroll">
            <table class="table">
                <thead>
                <tr>
                    {% if can_bulk %}
                        <th scope="col" class="select-column"><span class="visually-hidden">Select</span></th>
                    {% endif %}
                    <th scope="col">{{ list.sort_link('name', 'Name', filter) }}</th>
                    <th scope="col">Category</th>
                    <th scope="col">Member</th>
                    <th scope="col">Cycle</th>
                    <th scope="col">{{ list.sort_link('next_payment', 'Next charge', filter) }}</th>
                    <th scope="col" class="numeric">{{ list.sort_link('price', 'Price', filter) }}</th>
                    <th scope="col" class="numeric">Per month</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody>
                {% for subscription in subscriptions %}
                    <tr class="{{ subscription.isActive ? '' : 'is-paused' }}">
                        {% if can_bulk %}
                            <td class="select-column">
                                <input type="checkbox" name="ids[]" value="{{ subscription.id }}"
                                       aria-label="Select {{ subscription.name }}">
                            </td>
                        {% endif %}
                        <td>
                            <div class="cell-name">
                                {% if subscription.logoPath %}
                                    <img class="logo" src="/{{ subscription.logoPath }}" alt="" width="24" height="24">
                                {% endif %}
                                <div>
                                    <a href="/subscriptions/{{ subscription.id }}/edit">{{ subscription.name }}</a>
                                    {% if not subscription.isActive %}<span class="badge">Paused</span>{% endif %}
                                    {% if subscription.isTrial %}
                                        <span class="badge badge-warning">Trial</span>
                                    {% endif %}
                                    {% if subscription.splitMode.isSplit %}
                                        <span class="badge"
                                              title="{{ split_label(subscription.splitMode.value) }}">Shared</span>
                                    {% endif %}
                                    {% if subscription.tags %}
                                        <div class="tag-list">
                                            {% for tag in subscription.tags %}
                                                <span class="chip chip-static">{{ tag.name }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>{{ subscription.categoryName ?? '—' }}</td>
                        <td>{{ subscription.ownerName ?? '—' }}</td>
                        <td>
                            {{ type_label(subscription.type.value) }}
                            {% if subscription.billingCycle %}
                                · {{ cycle_label(subscription.billingCycle.value, subscription.cycleDays) }}
                            {% endif %}
                        </td>
                        <td>
                            {# For a trial this is the conversion, not the stale payment date. #}
                            {% if subscription.nextChargeDate %}
                                {{ subscription.nextChargeDate|date('j M Y') }}
                                {% if subscription.isTrial %}
                                    <div class="hint">Trial converts</div>
                                {% endif %}
                                {% set deadline = subscription.cancellationDeadline %}
                                {% if deadline %}
                                    <div class="hint">Cancel by {{ deadline|date('j M Y') }}</div>
                                {% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td class="numeric">{{ subscription.price.amountMinor|money(subscription.price.currency) }}</td>
                        <td class="numeric">
                            {% if subscription.monthlyMinor is not null %}
                                {{ subscription.monthlyMinor|money(subscription.price.currency) }}
                            {% else %}
                                <span class="muted" title="One-off and lifetime entries are not amortised">—</span>
                            {% endif %}
                        </td>
                        <td class="actions">
                            <a class="button button-quiet"
                               href="/subscriptions/{{ subscription.id }}/money">Cost</a>
                            {% if can(scope, 'subscription.update') %}
                                <form method="post" action="/subscriptions/{{ subscription.id }}/toggle" class="inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-quiet">
                                        {{ subscription.isActive ? 'Pause' : 'Resume' }}
                                    </button>
                                </form>
                            {% endif %}
                            {% if can(scope, 'subscription.delete') %}
                                <form method="post" action="/subscriptions/{{ subscription.id }}/delete" class="inline"
                                      onsubmit="return confirm('Delete {{ subscription.name|e('js') }}?')">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button button-danger">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if can_bulk %}
            <div class="bulk-bar">
                <label for="bulk-action">With selected</label>
                <select id="bulk-action" name="action">
                    <option value="category">Set category</option>
                    <option value="add_tag">Add tag</option>
                    <option value="remove_tag">Remove tag</option>
                    <option value="owner">Set member</option>
                    <option value="payer">Set payer</option>
                    <option value="currency">Convert currency</option>
                    <option value="activate">Resume</option>
                    <option value="deactivate">Pause</option>
                </select>

                <select name="category_id" aria-label="Category">
                    <option value="">No category</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                </select>

                <input type="text" name="tag" placeholder="Tag" aria-label="Tag">

                <select name="user_id" aria-label="Member">
                    <option value="">Nobody</option>
                    {% for member in members %}
                        <option value="{{ member.id }}">{{ member.display_name }}</option>
                    {% endfor %}
                </select>

                <select name="currency" aria-label="Currency">
                    {% for code in all_currencies %}
                        <option value="{{ code }}">{{ code }}</option>
                    {% endfor %}
                </select>

                <button type="submit" class="button">Apply</button>
            </div>
            <p class="hint">Converting currency uses today's exchange rate and records the result in each
                subscription's price history. If a rate is unavailable the whole action is refused rather than
                re-labelling the amount, which would be a silent price change.</p>
        {% endif %}

        {% if page_count > 1 %}
            <nav class="pager" aria-label="Pagination">
                {% if filter.page > 1 %}
                    <a class="button button-quiet"
                       href="/subscriptions?{{ filter.toQueryString({'page': filter.page - 1}) }}"
                       hx-get="/subscriptions?{{ filter.toQueryString({'page': filter.page - 1}) }}"
                       hx-target="#subscription-list" hx-select="#subscription-list"
                       hx-swap="outerHTML" hx-push-url="true">Previous</a>
                {% endif %}
                <span class="muted">Page {{ filter.page }} of {{ page_count }} · {{ total }} total</span>
                {% if filter.page < page_count %}
                    <a class="button button-quiet"
                       href="/subscriptions?{{ filter.toQueryString({'page': filter.page + 1}) }}"
                       hx-get="/subscriptions?{{ filter.toQueryString({'page': filter.page + 1}) }}"
                       hx-target="#subscription-list" hx-select="#subscription-list"
                       hx-swap="outerHTML" hx-push-url="true">Next</a>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
{% if can_bulk and subscriptions is not empty %}</form>{% endif %}
</section>

{% macro sort_link(key, label, filter) %}
    {% set direction = (filter.sort == key and filter.direction == 'asc') ? 'desc' : 'asc' %}
    {% set query = filter.toQueryString({'sort': key, 'dir': direction, 'page': null}) %}
    <a href="/subscriptions?{{ query }}"
       hx-get="/subscriptions?{{ query }}"
       hx-target="#subscription-list"
       hx-select="#subscription-list"
       hx-swap="outerHTML"
       hx-push-url="true">
        {{ label }}{% if filter.sort == key %}<span aria-hidden="true">{{ filter.direction == 'asc' ? ' ↑' : ' ↓' }}</span>{% endif %}
    </a>
{% endmacro %}
