{#
    The form, whole. It is also what the quick-add dialog loads, which is why
    it renders without the surrounding page when htmx asks for it: one
    definition of what a subscription needs, not a short version that drifts.
#}
{% extends is_htmx ? 'partials/bare.twig' : 'layout.twig' %}

{% set is_edit = subscription_id is not null %}

{#
    The heading and the action are blocks the shell renders, so the dialog —
    which extends `bare.twig` and renders neither — gets the form and only the
    form, exactly as it did when they were behind an `is_htmx` test here.
#}
{% block heading %}{{ is_edit ? t('subscriptions_form.edit_title') : t('subscriptions.add_subscription') }}{% endblock %}

{% block page_actions %}
    <a class="button button-quiet" href="/subscriptions">{{ t('subscriptions_form.back_to_list') }}</a>
{% endblock %}

{% block content %}
    {% include 'partials/errors.twig' %}

    <form class="card stack"
          method="post"
          enctype="multipart/form-data"
          action="{{ is_edit ? '/subscriptions/' ~ subscription_id : '/subscriptions' }}">
        {{ csrf_field() }}

        <div class="grid-2">
            <div class="stack">
                <label for="name">{{ t('field.name') }}</label>
                <input type="text" id="name" name="name" value="{{ values.name|default('') }}" required autofocus>
                {% if errors.name is defined %}<p class="field-error">{{ error_message(errors.name) }}</p>{% endif %}

                <label for="price">{{ t('field.price') }}</label>
                <div class="input-group">
                    <input type="text" id="price" name="price" inputmode="decimal"
                           value="{{ values.price|default('') }}" placeholder="{{ 9.99|decimal(2) }}" required>
                    <select name="currency" aria-label="{{ t('field.currency') }}">
                        {% for code in currencies %}
                            <option value="{{ code }}"
                                    {{ values.currency|default(base_currency) == code ? 'selected' : '' }}>{{ code }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% if errors.price is defined %}<p class="field-error">{{ error_message(errors.price) }}</p>{% endif %}
                {% if errors.currency is defined %}<p class="field-error">{{ error_message(errors.currency) }}</p>{% endif %}

                <label for="subscription_type">{{ t('field.type') }}</label>
                <select id="subscription_type" name="subscription_type">
                    {% for type in types %}
                        <option value="{{ type.value }}"
                                {{ values.subscription_type|default('recurring') == type.value ? 'selected' : '' }}>
                            {{ type_label(type.value) }}
                        </option>
                    {% endfor %}
                </select>
                <p class="hint">{{ t('subscriptions_form.type_hint') }}</p>

                <label for="billing_cycle">{{ t('subscriptions_form.billing_cycle') }}</label>
                <select id="billing_cycle" name="billing_cycle">
                    {% for cycle in cycles %}
                        <option value="{{ cycle.value }}"
                                {{ values.billing_cycle|default('monthly') == cycle.value ? 'selected' : '' }}>
                            {{ cycle_label(cycle.value) }}
                        </option>
                    {% endfor %}
                </select>
                {% if errors.billing_cycle is defined %}<p class="field-error">{{ error_message(errors.billing_cycle) }}</p>{% endif %}

                <label for="cycle_days">{{ t('subscriptions_form.days_between_payments') }}</label>
                <input type="number" id="cycle_days" name="cycle_days" min="1" max="3650"
                       value="{{ values.cycle_days|default('') }}">
                <p class="hint">{{ t('subscriptions_form.cycle_days_hint') }}</p>
                {% if errors.cycle_days is defined %}<p class="field-error">{{ error_message(errors.cycle_days) }}</p>{% endif %}
            </div>

            <div class="stack">
                <label for="next_payment_date">{{ t('subscriptions_form.next_payment_date') }}</label>
                <input type="date" id="next_payment_date" name="next_payment_date"
                       value="{{ values.next_payment_date|default('') }}">
                {% if errors.next_payment_date is defined %}
                    <p class="field-error">{{ error_message(errors.next_payment_date) }}</p>
                {% endif %}

                <label for="start_date">{{ t('subscriptions_form.started_on') }}</label>
                <input type="date" id="start_date" name="start_date" value="{{ values.start_date|default('') }}">
                <p class="hint">{{ t('subscriptions_form.start_date_hint') }}</p>

                <fieldset class="stack">
                    <legend>{{ t('subscriptions_form.free_trial') }}</legend>

                    <input type="hidden" name="is_trial" value="0">
                    <label class="choice">
                        <input type="checkbox" name="is_trial" value="1"
                               {{ values.is_trial|default('0') == '1' ? 'checked' : '' }}>
                        <span>{{ t('subscriptions_form.is_trial') }}</span>
                    </label>

                    <label for="trial_end_date">{{ t('subscriptions_form.trial_ends') }}</label>
                    <input type="date" id="trial_end_date" name="trial_end_date"
                           value="{{ values.trial_end_date|default('') }}">
                    <p class="hint">{{ t('subscriptions_form.trial_end_hint') }}</p>
                    {% if errors.trial_end_date is defined %}
                        <p class="field-error">{{ error_message(errors.trial_end_date) }}</p>
                    {% endif %}

                    <label for="converts_to_price">{{ t('subscriptions_form.converts_to') }}</label>
                    <input type="text" id="converts_to_price" name="converts_to_price" inputmode="decimal"
                           value="{{ values.converts_to_price|default('') }}" placeholder="{{ 9.99|decimal(2) }}">
                    <p class="hint">{{ t('subscriptions_form.converts_to_price_hint') }}</p>
                    {% if errors.converts_to_price is defined %}
                        <p class="field-error">{{ error_message(errors.converts_to_price) }}</p>
                    {% endif %}

                    <label for="converts_to_billing_cycle">{{ t('subscriptions_form.converts_to_cycle') }}</label>
                    <select id="converts_to_billing_cycle" name="converts_to_billing_cycle">
                        <option value="">{{ t('subscriptions_form.same_as_above') }}</option>
                        {% for cycle in cycles %}
                            <option value="{{ cycle.value }}"
                                    {{ values.converts_to_billing_cycle|default('') == cycle.value
                                        ? 'selected' : '' }}>
                                {{ cycle_label(cycle.value) }}
                            </option>
                        {% endfor %}
                    </select>

                    <label for="converts_to_cycle_days">{{ t('subscriptions_form.converts_to_cycle_days') }}</label>
                    <input type="number" id="converts_to_cycle_days" name="converts_to_cycle_days"
                           min="1" max="3650" value="{{ values.converts_to_cycle_days|default('') }}">
                    <p class="hint">{{ t('subscriptions_form.converts_to_cycle_days_hint') }}</p>
                    {% if errors.converts_to_cycle_days is defined %}
                        <p class="field-error">{{ error_message(errors.converts_to_cycle_days) }}</p>
                    {% endif %}
                </fieldset>

                <label for="notice_period_amount">{{ t('subscriptions_form.notice_period') }}</label>
                <div class="input-group">
                    <input type="number" id="notice_period_amount" name="notice_period_amount" min="0" max="3650"
                           value="{{ values.notice_period_amount|default('') }}" placeholder="{{ 0|decimal }}">
                    <select name="notice_period_unit" aria-label="{{ t('subscriptions_form.notice_period_unit') }}">
                        {% for unit in notice_units %}
                            <option value="{{ unit }}"
                                    {{ values.notice_period_unit|default('days') == unit ? 'selected' : '' }}>{{ unit }}</option>
                        {% endfor %}
                    </select>
                </div>
                <p class="hint">{{ t('subscriptions_form.notice_hint') }}</p>
                {% if errors.notice_period_amount is defined %}
                    <p class="field-error">{{ error_message(errors.notice_period_amount) }}</p>
                {% endif %}

                <label for="reminder_days">{{ t('subscriptions_form.reminders') }}</label>
                <input type="text" id="reminder_days" name="reminder_days"
                       value="{{ values.reminder_days|default('') }}"
                       placeholder="{{ t('subscriptions_form.use_my_usual_reminders') }}">
                <p class="hint">
                    {{ t('subscriptions_form.reminders_hint', {'example': '60, 14', 'never': 'none'}) }}
                    <a href="/settings/notifications">{{ t('subscriptions_form.reminders_hint_link') }}</a>.
                </p>
                {% if errors.reminder_days is defined %}<p class="field-error">{{ error_message(errors.reminder_days) }}</p>{% endif %}

                <label for="category_id">{{ t('field.category') }}</label>
                <select id="category_id" name="category_id">
                    <option value="">{{ t('state.none') }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}"
                                {{ values.category_id|default('') == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                    {% endfor %}
                </select>
                {% if errors.category_id is defined %}<p class="field-error">{{ error_message(errors.category_id) }}</p>{% endif %}

                <label for="owner_user_id">{{ t('subscriptions_form.belongs_to') }}</label>
                <select id="owner_user_id" name="owner_user_id" {{ scope.isOwnerRestricted ? 'disabled' : '' }}>
                    {% for member in members %}
                        <option value="{{ member.id }}"
                                {{ values.owner_user_id|default(current_user.id) == member.id ? 'selected' : '' }}>
                            {{ member.display_name }}
                        </option>
                    {% endfor %}
                </select>
                {% if scope.isOwnerRestricted %}
                    <p class="hint">{{ t('subscriptions_form.isolated_owner_note') }}</p>
                {% endif %}
                {% if errors.owner_user_id is defined %}<p class="field-error">{{ error_message(errors.owner_user_id) }}</p>{% endif %}

                <label for="payer_user_id">{{ t('subscriptions_form.paid_by') }}</label>
                <select id="payer_user_id" name="payer_user_id">
                    <option value="">{{ t('subscriptions_form.not_recorded') }}</option>
                    {% for member in members %}
                        <option value="{{ member.id }}"
                                {{ values.payer_user_id|default('') == member.id ? 'selected' : '' }}>
                            {{ member.display_name }}
                        </option>
                    {% endfor %}
                </select>
                {% if errors.payer_user_id is defined %}<p class="field-error">{{ error_message(errors.payer_user_id) }}</p>{% endif %}

                {#
                    Tags. A plain comma-separated text field, which is what the
                    server reads and what a browser with no JavaScript still
                    posts. `assets/js/tag-field.js` turns it into a searchable
                    combobox over the household's existing tags, driven by the
                    list below — choosing one and inventing one are the same
                    request, because `resolveOrCreate()` does both.
                #}
                <label for="tags">{{ t('field.tags') }}</label>
                <input type="text" id="tags" name="tags" value="{{ values.tags|default('') }}"
                       placeholder="{{ t('subscriptions_form.streaming_shared') }}"
                       data-tag-options="tag-options"
                       {#
                           The chip's remove button is built in JavaScript, so
                           the tag's name is not known here. The catalogue
                           still owns the sentence: it is rendered with a
                           marker in the name's place, and the script puts the
                           name there. Concatenating "Remove" and a name in the
                           script instead would be a word order this sentence
                           does not have in every language.
                       #}
                       data-remove-label="{{ t('subscriptions_form.remove_tag', {'name': '%s'}) }}">
                <datalist id="tag-options">
                    {% for tag in tags %}
                        <option value="{{ tag.name }}"></option>
                    {% endfor %}
                </datalist>
                <p class="hint">{{ t('subscriptions_form.tags_hint') }}</p>

                <label for="logo">{{ t('subscriptions_form.logo') }}</label>
                <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/gif,image/webp">
                {% if values.logo_path is defined and values.logo_path %}
                    <p class="hint">
                        <img class="logo" src="/{{ values.logo_path }}" alt="" width="32" height="32">
                        {{ t('subscriptions_form.logo_hint') }}
                    </p>
                {% endif %}
                {% if errors.logo is defined %}<p class="field-error">{{ error_message(errors.logo) }}</p>{% endif %}
            </div>
        </div>

        <label for="website_url">{{ t('field.website') }}</label>
        <input type="url" id="website_url" name="website_url" inputmode="url"
               value="{{ values.website_url|default('') }}"
               placeholder="{{ t('subscriptions_form.website_placeholder') }}"
               aria-describedby="website-hint">
        <p class="hint" id="website-hint">{{ t('subscriptions_form.website_hint') }}</p>
        {% if errors.website_url is defined %}
            <p class="field-error">{{ error_message(errors.website_url) }}</p>
        {% endif %}

        <label for="notes">{{ t('field.notes') }}</label>
        <textarea id="notes" name="notes" rows="3">{{ values.notes|default('') }}</textarea>
        {% if errors.notes is defined %}<p class="field-error">{{ error_message(errors.notes) }}</p>{% endif %}

        {#
            An unchecked checkbox submits nothing at all, so a hidden field
            carries the "off" value first; when the box is ticked the later
            value wins and the field reads 1.
        #}
        <input type="hidden" name="is_active" value="0">
        <label class="choice">
            <input type="checkbox" name="is_active" value="1"
                   {{ values.is_active|default('1') == '1' ? 'checked' : '' }}>
            <span>{{ t('state.active') }}</span>
        </label>

        <div class="form-actions">
            <button type="submit" class="button button-primary">
                {{ is_edit ? 'Save changes' : 'Add subscription' }}
            </button>
            <a class="button button-quiet" href="/subscriptions">{{ t('action.cancel') }}</a>
        </div>
    </form>
{% endblock %}
