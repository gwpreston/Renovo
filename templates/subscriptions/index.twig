{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.subscriptions') }}{% endblock %}

{% block content %}
    {#
        The screen the design asks for: the figures across the top, the list
        itself, then the two deadline sections and the trials, with the category
        widget and the saved views alongside. The list is the list — the same
        fragment htmx swaps — rather than a second one built for this
        arrangement.
    #}
    {% include 'subscriptions/_strip.twig' %}

    <div class="subscriptions-layout">
        <div class="subscriptions-main">
        {#
            The filter form drives the list through htmx: it replaces only the
            table, and pushes the query string so the view is bookmarkable and the
            back button works.
        #}
        <form class="card filters"
              hx-get="/subscriptions"
              hx-target="#subscription-list"
              hx-select="#subscription-list"
              hx-swap="outerHTML"
              hx-push-url="true"
              hx-trigger="change, keyup delay:300ms from:#q, submit">

            <div class="filter-row">
                <div class="filter-field grow">
                    <label for="q">{{ t('subscriptions.search') }}</label>
                    <input type="search" id="q" name="q" value="{{ filter.search }}"
                           placeholder="{{ t('subscriptions.name_or_notes') }}">
                </div>

                <div class="filter-field">
                    <label for="category">{{ t('field.category') }}</label>
                    <select id="category" name="category">
                        <option value="">{{ t('state.all') }}</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}"
                                    {{ filter.categoryId == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-field">
                    <label for="owner">{{ t('field.member') }}</label>
                    <select id="owner" name="owner">
                        <option value="">{{ t('state.all') }}</option>
                        {% for member in members %}
                            <option value="{{ member.id }}"
                                    {{ filter.ownerUserId == member.id ? 'selected' : '' }}>{{ member.display_name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-field">
                    <label for="currency">{{ t('field.currency') }}</label>
                    <select id="currency" name="currency">
                        <option value="">{{ t('state.all') }}</option>
                        {% for code in currencies %}
                            <option value="{{ code }}" {{ filter.currency == code ? 'selected' : '' }}>{{ code }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-field">
                    <label for="type">{{ t('field.type') }}</label>
                    <select id="type" name="type">
                        <option value="">{{ t('state.all') }}</option>
                        {% for type in types %}
                            <option value="{{ type.value }}"
                                    {{ filter.type and filter.type.value == type.value ? 'selected' : '' }}>
                                {{ type_label(type.value) }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <label class="filter-field choice">
                    <input type="checkbox" name="inactive" value="1" {{ filter.includeInactive ? 'checked' : '' }}>
                    <span>{{ t('subscriptions.include_paused') }}</span>
                </label>
            </div>

            {% if tags %}
                <div class="filter-tags">
                    {% for tag in tags %}
                        <label class="chip">
                            <input type="checkbox" name="tag[]" value="{{ tag.id }}"
                                   {{ tag.id in filter.tagIds ? 'checked' : '' }}>
                            <span>{{ tag.name }}</span>
                        </label>
                    {% endfor %}
                </div>
            {% endif %}

            <noscript><button type="submit" class="button">{{ t('subscriptions.apply_filters') }}</button></noscript>
        </form>

        {#
            The list fragment, included from here rather than wrapped from inside
            it: `#subscription-list` has to stay the outermost element of that file,
            because the filter form selects it and swaps it whole.
        #}
        {#
            `oob_query: false` because this page renders the real hidden field
            itself — in the saved-views card, now in the column alongside — and
            the fragment's out-of-band copy of it would be a second element with
            the same id.
        #}
        {% include 'subscriptions/_list.twig' with {'oob_query': false} %}

        {% include 'subscriptions/_expiring.twig' %}
        {% include 'subscriptions/_trials.twig' %}
        </div>

        <aside class="subscriptions-side">
            {% include 'subscriptions/_categories.twig' %}

            {#
                Saved views. Ordinary links, not an htmx swap: applying one is a change
                of view, and the address bar should say so — a saved view that cannot
                be bookmarked or shared is barely saved at all.
            #}
            <section class="card saved-views" aria-labelledby="saved-views-heading">
                <h2 id="saved-views-heading" class="stat-label">{{ t('saved_views.heading') }}</h2>

                {% if saved_views is empty %}
                    <p class="muted">{{ t('saved_views.empty') }}</p>
                {% else %}
                    <ul class="saved-view-list">
                        {% for view in saved_views %}
                            <li class="chip chip-static">
                                <a href="{{ view.path }}">{{ view.name }}</a>
                                <form method="post" action="/saved-views/{{ view.id }}/delete" class="inline">
                                    {{ csrf_field() }}
                                    <button type="submit" class="button-icon"
                                            aria-label="{{ t('saved_views.forget', {'name': view.name}) }}">×</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <form method="post" action="/saved-views" class="inline-form">
                    {{ csrf_field() }}
                    {#
                        What "save this view" would store. The filter form in the
                        other column swaps only the list, so this field would
                        otherwise still hold the query the page was *loaded* with
                        — which is how a view saved after filtering came out
                        empty. `_list.twig` sends a replacement for it out of band
                        on every filter, sort and page request; the id is what that
                        replacement aims at, so the two have to keep matching, and
                        that is why this card can sit in either column without the
                        out-of-band swap noticing.
                    #}
                    <input type="hidden" id="saved-view-query" name="query" value="{{ current_query }}">
                    <label for="saved-view-name" class="visually-hidden">{{ t('saved_views.name_label') }}</label>
                    <input type="text" id="saved-view-name" name="name" maxlength="60"
                           placeholder="{{ t('saved_views.name_placeholder') }}">
                    <button type="submit" class="button">{{ t('saved_views.save_current') }}</button>
                </form>
            </section>
        </aside>
    </div>
{% endblock %}
