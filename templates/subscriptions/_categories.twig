{#
    Category spending.

    The Statistics page's category breakdown, drawn as the design's proportion
    bars. What each bar is a share *of* is the whole claim it makes, so it is
    stated: one group against the combined monthly total when every currency
    converts, and otherwise a group per currency against that currency's own
    total. Unconvertible currencies are separated, never blended into one bar.

    A meter rather than a styled div: it carries the share to a screen reader,
    which a coloured strip does not.
#}
<section class="card category-widget" id="category-spending" aria-labelledby="category-widget-heading">
    <h2 id="category-widget-heading">{{ t('subscriptions.categories_heading') }}</h2>

    {% if category_spending.groups is empty %}
        <p class="muted empty">{{ t('subscriptions.categories_empty') }}</p>
    {% else %}
        {% if not category_spending.is_combined %}
            <p class="hint">
                {{ t('subscriptions.categories_per_currency', {
                    'currencies': category_spending.unconvertible|join(', '),
                }) }}
            </p>
        {% endif %}

        {% for group in category_spending.groups %}
            {% if not category_spending.is_combined %}
                <h3 class="stat-label">{{ group.currency }}</h3>
            {% endif %}

            <ul class="plain distribution">
                {% for row in group.rows %}
                    <li class="distribution-row">
                        <span class="distribution-name">{{ row.name }}</span>
                        <span class="distribution-amount">{{ row.amount_minor|money(group.currency) }}</span>
                        <div class="meter meter-slim" role="img"
                             aria-label="{{ t('dashboard.share_of_spend', {
                                 'name': row.name,
                                 'percent': row.percent,
                             }) }}">
                            <span class="meter-fill" style="width: {{ min(row.percent, 100) }}%"></span>
                        </div>
                    </li>
                {% endfor %}

                {% if group.other %}
                    {% set other_name = t('dashboard.other_categories', {'count': group.other.count}) %}
                    <li class="distribution-row">
                        <span class="distribution-name muted">{{ other_name }}</span>
                        <span class="distribution-amount">
                            {{ group.other.amount_minor|money(group.currency) }}
                        </span>
                        <div class="meter meter-slim" role="img"
                             aria-label="{{ t('dashboard.share_of_spend', {
                                 'name': other_name,
                                 'percent': group.other.percent,
                             }) }}">
                            <span class="meter-fill" style="width: {{ min(group.other.percent, 100) }}%"></span>
                        </div>
                    </li>
                {% endif %}
            </ul>

            <p class="hint">
                {{ t('subscriptions.categories_total', {
                    'total': group.total_minor|money(group.currency),
                }) }}
            </p>
        {% endfor %}
    {% endif %}
</section>
