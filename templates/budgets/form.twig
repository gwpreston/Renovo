{% extends 'layout.twig' %}

{% block heading %}{{ budget_id ? t('budgets_form.edit_title') : t('budgets.new_budget') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.budget_form') }}{% endblock %}

{% block content %}

    {% include 'partials/errors.twig' %}

    <section class="card narrow">
        <form method="post" action="{{ budget_id ? '/budgets/' ~ budget_id : '/budgets' }}" class="stack">
            {{ csrf_field() }}

            <label for="name">{{ t('field.name') }}</label>
            <input type="text" id="name" name="name" value="{{ values.name|default('') }}" required autofocus>
            {% if errors.name is defined %}<p class="field-error">{{ error_message(errors.name) }}</p>{% endif %}

            <label for="amount">{{ t('budgets_form.limit') }}</label>
            <div class="field-row">
                <input type="text" id="amount" name="amount" inputmode="decimal"
                       value="{{ values.amount|default('') }}" placeholder="{{ 150|decimal(2) }}" required>
                <select name="currency" aria-label="{{ t('field.currency') }}">
                    {% for code in currencies %}
                        <option value="{{ code }}"
                                {{ values.currency|default('GBP') == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>
            </div>
            {% if errors.amount is defined %}<p class="field-error">{{ error_message(errors.amount) }}</p>{% endif %}
            {% if errors.currency is defined %}<p class="field-error">{{ error_message(errors.currency) }}</p>{% endif %}

            <label for="period">{{ t('field.period') }}</label>
            <select id="period" name="period">
                {% for period in periods %}
                    <option value="{{ period.value }}"
                            {{ values.period|default('monthly') == period.value ? 'selected' : '' }}>
                        {{ budget_period_label(period.value) }}
                    </option>
                {% endfor %}
            </select>
            <p class="hint">{{ t('budgets_form.period_hint') }}</p>
            {% if errors.period is defined %}<p class="field-error">{{ error_message(errors.period) }}</p>{% endif %}

            <label for="category_id">{{ t('field.category') }}</label>
            <select id="category_id" name="category_id">
                <option value="">{{ t('budgets_form.everything') }}</option>
                {% for category in categories %}
                    <option value="{{ category.id }}"
                            {{ values.category_id|default('') == category.id ? 'selected' : '' }}>
                        {{ category.name }}
                    </option>
                {% endfor %}
            </select>
            {% if errors.category_id is defined %}<p class="field-error">{{ error_message(errors.category_id) }}</p>{% endif %}

            {#
                Whose spending: a member, or the whole household. Offered only
                to somebody who may measure more than themselves — an Owner/Admin
                or Editor in SHARED mode. Everybody else's budget measures them,
                and the field is left out so an edit keeps what is there.
            #}
            {% if not scope.restrictsWritesToOwner %}
                {% set subject = values.subject_user_id|default(values.owner_user_id|default(current_user.id)) %}
                <label for="subject_user_id">{{ t('budgets_form.whose_spending') }}</label>
                <select id="subject_user_id" name="subject_user_id">
                    <option value="household" {{ subject == 'household' ? 'selected' : '' }}>
                        {{ t('budgets.household') }}
                    </option>
                    {% for member in members %}
                        <option value="{{ member.id }}" {{ subject == member.id ? 'selected' : '' }}>
                            {{ member.display_name }}
                        </option>
                    {% endfor %}
                </select>
                <p class="hint">{{ t('budgets_form.subject_hint') }}</p>
                {% if errors.subject_user_id is defined %}
                    <p class="field-error">{{ error_message(errors.subject_user_id) }}</p>
                {% endif %}
            {% endif %}

            <label for="warn_threshold_percent">{{ t('budgets_form.warn_at_optional') }}</label>
            <div class="field-row">
                <input type="number" id="warn_threshold_percent" name="warn_threshold_percent" min="1" max="100"
                       value="{{ values.warn_threshold_percent|default('') }}" placeholder="{{ 90|decimal }}">
                <span class="field-suffix">{{ percent_symbol() }}</span>
            </div>
            <p class="hint">{{ t('budgets_form.threshold_hint') }}</p>
            {% if errors.warn_threshold_percent is defined %}
                <p class="field-error">{{ error_message(errors.warn_threshold_percent) }}</p>
            {% endif %}

            <input type="hidden" name="is_active" value="0">
            <label class="choice">
                <input type="checkbox" name="is_active" value="1"
                       {{ values.is_active|default('1') == '1' ? 'checked' : '' }}>
                <span>{{ t('state.active') }}</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-primary">{{ t('budgets_form.save_budget') }}</button>
                <a class="button button-quiet" href="/budgets">{{ t('action.cancel') }}</a>
            </div>
        </form>

        {% if budget_id and can(scope, 'budget.manage') %}
            <form method="post" action="/budgets/{{ budget_id }}/delete" class="stack"
                  onsubmit="return confirm('{{ t('confirm.delete_budget')|e('js') }}')">
                {{ csrf_field() }}
                <button type="submit" class="button button-danger">{{ t('budgets_form.delete_budget') }}</button>
            </form>
        {% endif %}
    </section>
{% endblock %}
