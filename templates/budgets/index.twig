{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.budgets') }}{% endblock %}

{% block page_actions %}
    {% if can(scope, 'budget.manage') %}
        <a class="button button-primary" href="/budgets/new">{{ t('budgets.new_budget') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <p class="muted note">
        {{ t('budgets.intro') }}
    </p>

    {% if progress is empty %}
        <section class="card">
            <p class="muted empty">
                {{ t('budgets.empty') }}
                {% if can(scope, 'budget.manage') %}<a href="/budgets/new">{{ t('budgets.set_one_up') }}</a>{% endif %}
            </p>
        </section>
    {% else %}
        <div class="budget-grid">
            {% for row in progress %}
                {% set budget = row.budget %}
                <article class="card budget {{ row.is_over ? 'is-over' : (row.is_warning ? 'is-warning' : '') }}">
                    <header class="budget-header num">
                        <h2>{{ budget.name }}</h2>
                        {% if can(scope, 'budget.manage') %}
                            <a class="button button-quiet" href="/budgets/{{ budget.id }}/edit">{{ t('action.edit') }}</a>
                        {% endif %}
                    </header>

                    <p class="muted">
                        {{ budget_period_label(budget.period.value) }} ·
                        {{ budget.isOverall ? t('budgets.all_categories') : budget.categoryName }}
                        {% if budget.ownerName %} · {{ budget.ownerName }}{% endif %}
                    </p>

                    {% if row.projected is null %}
                        <p class="stat-value num">—</p>
                        <p class="field-error">
                            {{ t('budgets.unconvertible', {'currencies': row.unconvertible|join(', ')}) }}
                        </p>
                    {% else %}
                        <p class="stat-value num">
                            {{ row.projected.amountMinor|money(row.projected.currency) }}
                            <span class="stat-unit num">
                                {{ t('budgets.of_limit', {'limit': row.limit.amountMinor|money(row.limit.currency)}) }}
                            </span>
                        </p>

                        {# A meter rather than a bar: it carries the value and the limit to a screen reader. #}
                        <div class="meter" role="img"
                             aria-label="{{ t('budgets.meter_label', {'percent': row.percent}) }}">
                            <span class="meter-fill" style="width: {{ min(row.percent, 100) }}%"></span>
                        </div>

                        <p class="{{ row.is_over ? 'field-error' : 'muted' }}">
                            {% if row.is_over %}
                                <strong>{{ t('budgets.over', {
                                    'percent': row.percent,
                                    'amount': (row.remaining.amountMinor * -1)|money(row.remaining.currency),
                                }) }}</strong>
                            {% elseif row.is_warning %}
                                {{ t('budgets.warning', {
                                    'percent': row.percent,
                                    'threshold': budget.warnThresholdPercent,
                                    'remaining': row.remaining.amountMinor|money(row.remaining.currency),
                                }) }}
                            {% else %}
                                {{ t('budgets.remaining', {
                                    'percent': row.percent,
                                    'remaining': row.remaining.amountMinor|money(row.remaining.currency),
                                }) }}
                            {% endif %}
                        </p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>

        <p class="muted note">
            {{ t('budgets.alerts_note') }}
        </p>
    {% endif %}
{% endblock %}
