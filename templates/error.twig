{% extends 'auth/_layout.twig' %}

{#
    Every error page — 404, 403, 500, an expired session — in the signed-out
    layout.

    HttpErrorHandler renders with no user whoever is reading, because the
    failure may have come before the account was loaded; so this page is the
    same card for everybody. What differs is the way back, which the handler
    decides from whether the session names an account: a stranger is offered
    the sign-in form, a signed-in reader their dashboard.
#}

{% set card_icon = status == 500 ? 'warn' : 'alert' %}

{% block title %}{{ title }} — {{ instance_name }}{% endblock %}
{% block card_title %}{{ title }}{% endblock %}
{% block card_intro %}{{ message }}{% endblock %}

{% block card_body %}
    {% if trace %}
        <pre class="trace">{{ trace }}</pre>
    {% endif %}

    {% set signed_in = signed_in|default(false) %}
    <a class="button button-primary auth-submit" href="{{ signed_in ? '/' : '/login' }}">
        {{- signed_in ? t('error.back_to_the_dashboard') : t('action.back_to_sign_in') -}}
    </a>
{% endblock %}
