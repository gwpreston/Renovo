{% extends 'layout.twig' %}

{% block heading %}{{ t('backup.title') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.backup') }}{% endblock %}

{% block content %}
    <section class="card">
        <h2>{{ t('backup.export') }}</h2>

        <p>
            {{ t('backup.export_intro') }}
        </p>

        <p class="muted">
            {{ t('backup.export_scope') }}
        </p>

        <p class="muted">
            {{ t('backup.export_exclusions') }}
        </p>

        {% if private_left_out > 0 %}
            <p class="muted" data-private-left-out="{{ private_left_out }}">
                {{ t('backup.private_left_out', {'count': private_left_out}) }}
            </p>
        {% endif %}

        <form method="post" action="/settings/backup/export" class="inline">
            {{ csrf_field() }}
            <button type="submit" class="button button-primary">{{ t('backup.download_backup') }}</button>
        </form>
    </section>

    <section class="card">
        <h2>{{ t('backup.restore') }}</h2>

        <p>
            {{ t('backup.restore_is_additive') }}
        </p>

        <p class="muted">
            {{ t('backup.restore_matching') }}
        </p>

        <form method="post" action="/settings/backup/restore" enctype="multipart/form-data" class="stack"
              onsubmit="return confirm('{{ t('confirm.restore_backup')|e('js') }}')">
            {{ csrf_field() }}

            <label for="restore-archive">{{ t('backup.archive_label', {'version': format_version}) }}</label>
            <input type="file" id="restore-archive" name="archive" accept=".zip,application/zip" required>

            <button type="submit" class="button">{{ t('backup.restore') }}</button>
        </form>
    </section>
{% endblock %}
