{% extends 'layout.twig' %}

{% block title %}Set up your authenticator — {{ instance_name }}{% endblock %}

{% block content %}
    <section class="card narrow">
        <h1>Set up your authenticator app</h1>

        <ol class="stack">
            <li>Scan this code with your authenticator app, or enter the key by hand.</li>
            <li>Type the six-digit code it shows, to prove the app has the key.</li>
        </ol>

        <div class="qr">{{ qr_code|raw }}</div>

        <p class="muted">
            Setup key: <code>{{ secret }}</code>
        </p>

        <form method="post" action="/settings/security/totp/confirm" class="stack">
            {{ csrf_field() }}

            <label for="code">Six-digit code</label>
            <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
                   pattern="[0-9]{6}" maxlength="6" required autofocus>
            {% if errors.code is defined %}<p class="field-error">{{ errors.code }}</p>{% endif %}

            <button type="submit" class="button button-primary">Turn on two-step verification</button>
        </form>

        <form method="post" action="/settings/security/totp/cancel" class="inline">
            {{ csrf_field() }}
            <button type="submit" class="button button-quiet">Cancel</button>
        </form>
    </section>
{% endblock %}
