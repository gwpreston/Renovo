{% extends 'layout.twig' %}

{% block title %}{{ t('security.title') }} — {{ instance_name }}{% endblock %}

{% block content %}
    <h1>{{ t('security.title') }}</h1>

    {% if recovery_codes is not empty %}
        <section class="card callout">
            <h2>{{ t('security.your_recovery_codes') }}</h2>
            <p>
                {{ t('security.recovery_codes_note') }}
            </p>
            <ul class="code-list">
                {% for code in recovery_codes %}
                    <li><code>{{ code }}</code></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="card">
        <h2>{{ t('security.authenticator_app') }}</h2>

        {% if totp.enabled %}
            <p>{{ t('security.totp_on') }}</p>

            <form method="post" action="/settings/security/totp/disable" class="stack">
                {{ csrf_field() }}
                <label for="disable-password">{{ t('security.totp_off_password_label') }}</label>
                <input type="password" id="disable-password" name="password"
                       autocomplete="current-password" required>
                <button type="submit" class="button button-danger">{{ t('security.turn_off') }}</button>
            </form>
        {% else %}
            <p class="muted">
                {{ t('security.totp_off') }}
            </p>

            <form method="post" action="/settings/security/totp" class="inline">
                {{ csrf_field() }}
                <button type="submit" class="button button-primary">{{ t('security.totp_setup_action') }}</button>
            </form>
        {% endif %}
    </section>

    <section class="card">
        <h2>{{ t('security.passkeys_and_security_keys') }}</h2>
        <p class="muted">
            {{ t('security.passkeys_intro') }}
        </p>

        {% if passkeys is empty %}
            <p class="muted">{{ t('security.none_registered') }}</p>
        {% else %}
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">{{ t('field.name') }}</th>
                    <th scope="col">{{ t('field.added') }}</th>
                    <th scope="col">{{ t('field.last_used') }}</th>
                    <th scope="col">{{ t('security.transports') }}</th>
                    <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                {% for passkey in passkeys %}
                    <tr>
                        <td>
                            <form method="post" action="/settings/security/passkeys/{{ passkey.id }}/rename"
                                  class="inline">
                                {{ csrf_field() }}
                                <input type="text" name="name" value="{{ passkey.name }}" maxlength="100"
                                       aria-label="{{ t('security.passkey_name') }}">
                                <button type="submit" class="button button-quiet">{{ t('action.rename') }}</button>
                            </form>
                        </td>
                        <td>{{ passkey.createdAt|local_date('d MMM y') }}</td>
                        <td>{{ passkey.lastUsedAt ? passkey.lastUsedAt|local_date('d MMM y HH:mm') : 'Never' }}</td>
                        <td class="muted">{{ passkey.transportSummary }}</td>
                        <td>
                            <form method="post" action="/settings/security/passkeys/{{ passkey.id }}/delete"
                                  class="inline">
                                {{ csrf_field() }}
                                <button type="submit" class="button button-danger">{{ t('action.revoke') }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <div class="stack">
            <label for="passkey-name">{{ t('security.passkey_name_label') }}</label>
            <input type="text" id="passkey-name" maxlength="100" placeholder="{{ t('security.phone_yubikey_laptop') }}">
            <button type="button" class="button button-primary" id="passkey-register">{{ t('security.add_a_passkey') }}</button>
            <p class="field-error" id="passkey-register-error" hidden></p>
        </div>
    </section>

    {#
        Recovery codes sit outside both factors, because they cover either one:
        an account whose only second factor is a passkey needs them just as much.
    #}
    {% if recovery.applicable %}
        <section class="card">
            <h2>{{ t('security.recovery_codes') }}</h2>
            <p class="muted">
                {{ t('security.recovery_remaining', {'count': recovery.remaining}) }}
            </p>

            <form method="post" action="/settings/security/recovery-codes" class="stack">
                {{ csrf_field() }}
                <label for="recovery-password">{{ t('security.recovery_password_label') }}</label>
                <input type="password" id="recovery-password" name="password"
                       autocomplete="current-password" required>
                <button type="submit" class="button">{{ t('security.regenerate_recovery_codes') }}</button>
            </form>
        </section>
    {% endif %}

    <section class="card">
        <h2>{{ t('security.active_sessions') }}</h2>
        <p class="muted">
            {{ t('security.sessions_intro') }}
        </p>

        <table class="table">
            <thead>
            <tr>
                <th scope="col">{{ t('field.device') }}</th>
                <th scope="col">{{ t('field.address') }}</th>
                <th scope="col">{{ t('field.started') }}</th>
                <th scope="col">{{ t('field.last_seen') }}</th>
                <th scope="col"></th>
            </tr>
            </thead>
            <tbody>
            {% for item in sessions %}
                <tr>
                    <td>
                        {{ item.deviceLabel }}
                        {% if item.isCurrent %}<span class="badge">{{ t('security.this_device') }}</span>{% endif %}
                    </td>
                    <td class="muted">{{ item.ipAddress|default('Unknown') }}</td>
                    <td>{{ item.createdAt ? item.createdAt|local_date('d MMM y HH:mm') : '—' }}</td>
                    <td>{{ item.lastActivity|local_date('d MMM y HH:mm') }}</td>
                    <td>
                        {% if not item.isCurrent %}
                            <form method="post" action="/settings/security/sessions/revoke" class="inline">
                                {{ csrf_field() }}
                                <input type="hidden" name="handle" value="{{ item.handle }}">
                                <button type="submit" class="button button-danger">{{ t('action.revoke') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if sessions|length > 1 %}
            <form method="post" action="/settings/security/sessions/revoke-others" class="inline">
                {{ csrf_field() }}
                <button type="submit" class="button button-danger">{{ t('security.sign_out_everywhere_else') }}</button>
            </form>
        {% endif %}
    </section>

    <script src="/assets/webauthn.js" defer></script>
    <script type="module">
        window.renovoWebAuthn.bindRegistration({
            button: document.getElementById('passkey-register'),
            error: document.getElementById('passkey-register-error'),
            nameInput: document.getElementById('passkey-name'),
            optionsUrl: '/settings/security/passkeys/options',
            registerUrl: '/settings/security/passkeys',
            csrf: '{{ csrf_token() }}',
        });
    </script>
{% endblock %}
