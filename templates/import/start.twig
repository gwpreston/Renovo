{% extends 'layout.twig' %}

{#
    No `title` block: the layout derives the tab's name from the heading, and
    this page's heading is what it is called. The override said "Import", which
    was the rail's label for it — and the rail no longer has one.
#}
{% block heading %}{{ t('import_start.import_subscriptions') }}{% endblock %}

{% block content %}
    <p class="muted">
        {{ t('import_start.intro') }}
    </p>

    <section class="card">
        <form method="post" action="/import" enctype="multipart/form-data" class="stack">
            {{ csrf_field() }}

            <label for="import-file">{{ t('field.file') }}</label>
            <input type="file" id="import-file" name="file" accept=".csv,.json,.txt,text/csv,application/json"
                   required>
            <p class="field-hint">
                {{ t('import_start.file_hint', {'rows': max_rows}) }}
            </p>

            <label for="import-preset">{{ t('import_start.it_came_from') }}</label>
            <select id="import-preset" name="preset">
                {% for key, label in presets %}
                    <option value="{{ key }}">{{ label }}</option>
                {% endfor %}
            </select>
            <p class="field-hint">
                {{ t('import_start.source_hint') }}
            </p>

            <button type="submit" class="button button-primary">{{ t('action.continue') }}</button>
        </form>
    </section>
{% endblock %}
