{% extends 'layout.twig' %}

{% block title %}{{ t('import_map.title') }} — {{ instance_name }}{% endblock %}

{% block heading %}{{ t('import_map.map_the_columns') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.import_map') }}{% endblock %}

{% block content %}
    <p class="muted">
        <strong>{{ filename }}</strong> —
        {{ t('import_map.summary', {'rows': row_count, 'preset': preset_label}) }}
    </p>

    <form method="post" action="/import/preview" class="stack">
        {{ csrf_field() }}

        <section class="card">
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('import_map.field') }}</th>
                        <th scope="col">{{ t('import_map.column_in_your_file') }}</th>
                        <th scope="col">{{ t('import_map.example') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for field in fields %}
                        {% set chosen = mapping[field.value] ?? '' %}
                        <tr>
                            <td>
                                <label for="map-{{ field.value }}">
                                    {{ t(field.labelKey()) }}{{ field.isRequired() ? ' *' : '' }}
                                </label>
                                {% if field.hintKey() %}
                                    <span class="field-hint">{{ t(field.hintKey()) }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <select id="map-{{ field.value }}" name="mapping[{{ field.value }}]">
                                    <option value="">{{ t('import_map.do_not_import') }}</option>
                                    {% for header in headers %}
                                        <option value="{{ header }}"
                                                {{ chosen == header ? 'selected' : '' }}>{{ header }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td class="muted">
                                {%- if chosen and sample|length > 0 -%}
                                    {{ sample[0][chosen]|default('')|slice(0, 40) }}
                                {%- endif -%}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <p class="field-hint">{{ t('import_map.required_note') }}</p>
        </section>

        <div class="form-actions">
            <button type="submit" class="button button-primary">{{ t('action.preview') }}</button>
            <button type="submit" class="button button-quiet" formaction="/import/cancel">{{ t('action.cancel') }}</button>
        </div>
    </form>
{% endblock %}
