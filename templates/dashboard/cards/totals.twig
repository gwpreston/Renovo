{#
    The metric row.

    Four tiles, whatever the household's currencies are. Monthly and yearly
    spend each show their per-currency subtotals, with the combined figure
    alongside only when every currency in play converts — so a tile may be two
    lines tall, which is the correct answer rather than a compromise. A single
    big number that silently left out a currency would be a wrong number.
#}
{% import _self as metric %}

<section class="metric-grid" aria-label="{{ t('dashboard.metrics') }}">
    <article class="card stat metric">
        <h2 class="stat-label">{{ t('dashboard.monthly_spend') }}</h2>
        {{ metric.spend(metrics.monthly, t('dashboard.per_month_unit')) }}
    </article>

    <article class="card stat metric">
        <h2 class="stat-label">{{ t('dashboard.yearly_spend') }}</h2>
        {{ metric.spend(metrics.yearly, t('dashboard.per_year_unit')) }}
    </article>

    <article class="card stat metric">
        <h2 class="stat-label">{{ t('dashboard.renewing_soon') }}</h2>
        <p class="stat-value">{{ metrics.renewals.count }}</p>
        <p class="muted">{{ t('dashboard.renewing_soon_note', {'days': metrics.renewals.days}) }}</p>
        {% if metrics.renewals.total is not empty %}
            <p class="muted">
                {% for total in metrics.renewals.total %}
                    {{ total.total_minor|money(total.currency) }}{{ not loop.last ? ' · ' : '' }}
                {% endfor %}
                {{ t('dashboard.due_in_total') }}
            </p>
        {% endif %}
    </article>

    {#
        Where the design put a virtual card. There is no card and no PAN, so
        this holds what is true instead: how many subscriptions are running,
        and what the next charge is.
    #}
    <article class="card stat metric">
        <h2 class="stat-label">{{ t('dashboard.active_subscriptions') }}</h2>
        <p class="stat-value">{{ metrics.portfolio.active_count }}</p>
        {% if metrics.portfolio.next %}
            {% set next = metrics.portfolio.next %}
            <p class="muted">{{ t('dashboard.next_charge', {
                'name': next.subscription.name,
                'date': next.date|local_date('d MMM'),
                'amount': next.amount.amountMinor|money(next.amount.currency),
            }) }}</p>
        {% else %}
            <p class="muted">{{ t('dashboard.nothing_due') }}</p>
        {% endif %}
    </article>
</section>

{#
    One-off and lifetime entries, kept out of the recurring figures on purpose:
    spreading a lifetime licence over an arbitrary period would make the
    monthly number mean nothing.
#}
{% if metrics.one_off is not empty %}
    <p class="muted note">
        {% for total in metrics.one_off %}
            {{ t('dashboard.one_off_in', {'currency': total.currency}) }}
            {{ total.total_minor|money(total.currency) }}
            ({{ t('dashboard.one_off_note', {'count': total.count}) }}){{ not loop.last ? ' · ' : '' }}
        {% endfor %}
    </p>
{% endif %}

{#
    A tile's figures, per currency, with the combined total when there is an
    honest one to show.
#}
{% macro spend(figures, unit) %}
    {% if figures.totals is empty %}
        <p class="stat-value">{{ t('common.none_symbol') }}</p>
        <p class="muted">{{ t('dashboard.recurring_empty') }}</p>
    {% elseif figures.totals|length == 1 %}
        <p class="stat-value">
            {{ figures.totals[0].amount_minor|money(figures.totals[0].currency) }}
            <span class="stat-unit">{{ unit }}</span>
        </p>
    {% elseif figures.combined.amount_minor is not null %}
        <p class="stat-value">
            {{ figures.combined.amount_minor|money(figures.combined.currency) }}
            <span class="stat-unit">{{ unit }}</span>
        </p>
        <p class="muted">
            {% for total in figures.totals %}
                {{ total.amount_minor|money(total.currency) }}{{ not loop.last ? ' · ' : '' }}
            {% endfor %}
        </p>
    {% else %}
        {# No rate for one of them, so there is no total — only the subtotals. #}
        <ul class="plain stat-lines">
            {% for total in figures.totals %}
                <li class="stat-value stat-line">{{ total.amount_minor|money(total.currency) }}</li>
            {% endfor %}
        </ul>
        <p class="hint">
            {{ t('dashboard.unconvertible', {
                'currencies': figures.combined.unconvertible|join(', '),
            }) }}
        </p>
    {% endif %}
{% endmacro %}
