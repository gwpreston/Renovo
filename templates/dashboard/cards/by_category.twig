{# Where the money goes. #}
{% if stats.by_category %}
    <section class="card">
        <h2>{{ t('dashboard.by_category') }}</h2>
        {# Wrapped, like every other table: three columns of figures do not fit a phone. #}
        <div class="table-scroll">
        <table class="table">
            <thead>
            <tr>
                <th scope="col">{{ t('field.category') }}</th>
                <th scope="col">{{ t('field.subscriptions') }}</th>
                <th scope="col" class="numeric">{{ t('field.per_month') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for row in stats.by_category %}
                <tr>
                    <td>{{ row.name }}</td>
                    <td>{{ row.count }}</td>
                    <td class="numeric">{{ row.monthly_minor|money(row.currency) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </section>
{% endif %}
