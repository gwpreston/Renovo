{#
    Coming soon — a month and a half of charges, in date order.

    Each row carries how far away its charge is rather than the date it falls
    on: over this long a window "23 days" is the thing being asked, and the
    calendar page is where a date belongs. The near ones are marked, and which
    ones count as near is `StatsService`'s judgement, not this template's.
#}
{% import 'partials/logo.twig' as logo %}
<section class="card">
    <h2>{{ t('dashboard.coming_soon') }}</h2>
    <p class="muted">{{ t('dashboard.coming_soon_note', {'days': stats.upcoming_days}) }}</p>

    {% if stats.upcoming is empty %}
        <p class="muted">{{ t('dashboard.nothing_due') }}</p>
    {% else %}
        <ul class="renewals">
            {% for row in stats.upcoming %}
                <li>
                    <span class="renewal-name">
                        {{ logo.mark(row.subscription, 20) }}{{ row.subscription.name }}
                    </span>
                    <span class="renewal-days {{ row.is_urgent ? 'is-due-soon' : '' }}">
                        {% if row.days == 0 %}
                            {{ t('state.today') }}
                        {% else %}
                            {{ t('dashboard.days_away', {'days': row.days}) }}
                        {% endif %}
                    </span>
                    <span class="renewal-amount">
                        {{ row.subscription.price.amountMinor|money(row.subscription.price.currency) }}
                    </span>
                </li>
            {% endfor %}
        </ul>
        <p class="muted">
            {% for total in stats.upcoming_totals %}
                {{ total.total_minor|money(total.currency) }}{{ not loop.last ? ' · ' : '' }}
            {% endfor %}
            {{ t('dashboard.due_in_total') }}
        </p>
    {% endif %}
</section>
