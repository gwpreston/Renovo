{#
    The subscriptions table.

    Every row comes through the repository the list page uses, so the scoping
    layer decides what is in it exactly as it does there: on an ISOLATED
    instance, this member's own subscriptions plus anything they help pay for.
    The controls a Viewer does not get are absent because the permission says
    so — and they would be refused by the middleware even if they were not.
#}
<section class="card recent-card">
    <header class="card-header">
        <h2>{{ t('dashboard.recent') }}</h2>

        <div class="card-header-actions">
            <a class="button button-quiet" href="/subscriptions">{{ t('dashboard.see_all') }}</a>

            {#
                Export is the export this application already has, reached from
                here rather than reimplemented — which is why it asks for the
                role that may manage a backup rather than inventing a second
                answer to "who may take the data out".
            #}
            {% if can(scope, 'backup.manage') %}
                <form method="post" action="/settings/backup/export" class="inline">
                    {{ csrf_field() }}
                    <button type="submit" class="button button-quiet">{{ t('backup.export') }}</button>
                </form>
            {% endif %}
        </div>
    </header>

    {% include 'dashboard/_recent_table.twig' %}
</section>
