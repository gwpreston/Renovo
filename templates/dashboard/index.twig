{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.dashboard') }}{% endblock %}

{% block content %}
    {% if not scope.hasHousehold %}
        <section class="card">
            <h2>{{ t('dashboard.no_household') }}</h2>
            <p class="muted">{{ t('dashboard.no_household_note') }}</p>
        </section>
    {% else %}
        {#
            One template per card, included in the order this user chose. The
            order and the hiding are decided by DashboardLayoutService; this
            walks the list it produced and nothing else, so adding a card is
            adding a file and an enum case.
        #}
        {% for card in dashboard_cards %}
            {% include 'dashboard/cards/' ~ card.value ~ '.twig' %}
        {% endfor %}
    {% endif %}
{% endblock %}
