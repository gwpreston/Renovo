{% extends 'layout.twig' %}

{% block title %}Dashboard — {{ instance_name }}{% endblock %}

{% block content %}
    {# Twig 3 requires macros in the same file to be imported before use. #}
    {% import _self as ui %}

    <div class="page-header">
        <h1>Dashboard</h1>
        {% if can(scope, 'subscription.create') %}
            <a class="button button-primary" href="/subscriptions/new">Add subscription</a>
        {% endif %}
    </div>

    {% if not scope.hasHousehold %}
        <section class="card">
            <h2>No household</h2>
            <p class="muted">You are not a member of a household yet, so there is nothing to show. Instance
                administration does not by itself grant access to anybody's subscriptions.</p>
        </section>
    {% else %}
        <section class="stat-grid">
            {% for total in stats.recurring %}
                <article class="card stat">
                    <h2 class="stat-label">Recurring · {{ total.currency }}</h2>
                    <p class="stat-value">{{ total.monthly_minor|money(total.currency) }}<span class="stat-unit"> / month</span></p>
                    <p class="muted">{{ total.yearly_minor|money(total.currency) }} per year · {{ total.count }}
                        subscription{{ total.count == 1 ? '' : 's' }}</p>
                </article>
            {% else %}
                <article class="card stat">
                    <h2 class="stat-label">Recurring</h2>
                    <p class="stat-value">—</p>
                    <p class="muted">No active recurring subscriptions yet.</p>
                </article>
            {% endfor %}

            {% for total in stats.one_off %}
                <article class="card stat">
                    <h2 class="stat-label">One-off &amp; lifetime · {{ total.currency }}</h2>
                    <p class="stat-value">{{ total.total_minor|money(total.currency) }}</p>
                    {#
                        Kept out of the recurring figures on purpose: spreading a
                        lifetime licence over an arbitrary period would make the
                        monthly number mean nothing.
                    #}
                    <p class="muted">{{ total.count }} entr{{ total.count == 1 ? 'y' : 'ies' }}, not included
                        in monthly totals</p>
                </article>
            {% endfor %}
        </section>

        {% if stats.combined_monthly.amount_minor is not null and stats.recurring|length > 1 %}
            <section class="card stat">
                <h2 class="stat-label">Combined · {{ stats.combined_monthly.currency }}</h2>
                <p class="stat-value">
                    {{ stats.combined_monthly.amount_minor|money(stats.combined_monthly.currency) }}
                    <span class="stat-unit"> / month</span>
                </p>
                <p class="muted">
                    {{ stats.combined_yearly.amount_minor|money(stats.combined_yearly.currency) }} per year,
                    converted at the latest cached rates. The per-currency figures above are the amounts
                    actually charged.
                </p>
            </section>
        {% elseif stats.combined_monthly.unconvertible is not empty %}
            <p class="muted note">
                Totals are shown per currency. They cannot be combined because no exchange rate is available
                for {{ stats.combined_monthly.unconvertible|join(', ') }} — a total leaving that out would be
                a wrong number rather than an approximate one.
            </p>
        {% endif %}

        {% if stats.trials is not empty %}
            <section class="card callout">
                <h2>Trials ending soon</h2>
                <p class="muted">Free today. About to stop being.</p>
                <ul class="renewals">
                    {% for trial in stats.trials %}
                        <li>
                            <span class="renewal-name">
                                <a href="/subscriptions/{{ trial.id }}/money">{{ trial.name }}</a>
                            </span>
                            <span class="renewal-date">
                                converts {{ trial.trialEndDate|date('j M') }}
                            </span>
                            <span class="renewal-amount">
                                {{ trial.priceAfterConversion.amountMinor|money(
                                    trial.priceAfterConversion.currency) }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
                <p class="muted">
                    {% for total in stats.trial_totals %}
                        {{ total.total_minor|money(total.currency) }}{{ not loop.last ? ' · ' : '' }}
                    {% endfor %}
                    about to start being charged
                </p>
            </section>
        {% endif %}

        <div class="columns">
            <section class="card">
                <h2>Next 7 days</h2>
                {{ ui.upcoming(stats.upcoming_7, stats.upcoming_7_totals) }}
            </section>

            <section class="card">
                <h2>Next 30 days</h2>
                {{ ui.upcoming(stats.upcoming_30, stats.upcoming_30_totals) }}
            </section>
        </div>

        <section class="stat-grid">
            {% for label, amount in stats.per_period %}
                <article class="card stat stat-small">
                    <h2 class="stat-label">Per {{ label|replace({'daily': 'day', 'weekly': 'week',
                        'monthly': 'month', 'yearly': 'year'}) }}</h2>
                    <p class="stat-value">
                        {{ amount is not null ? amount|money(stats.combined_yearly.currency) : '—' }}
                    </p>
                </article>
            {% endfor %}
        </section>

        {% if stats.by_category %}
            <section class="card">
                <h2>By category</h2>
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">Category</th>
                        <th scope="col">Subscriptions</th>
                        <th scope="col" class="numeric">Per month</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in stats.by_category %}
                        <tr>
                            <td>{{ row.name }}</td>
                            <td>{{ row.count }}</td>
                            <td class="numeric">{{ row.monthly_minor|money(row.currency) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}

{% macro upcoming(items, totals) %}
    {% if items is empty %}
        <p class="muted">Nothing due.</p>
    {% else %}
        <ul class="renewals">
            {% for item in items %}
                <li>
                    <span class="renewal-name">{{ item.name }}</span>
                    <span class="renewal-date">{{ item.nextPaymentDate|date('j M') }}</span>
                    <span class="renewal-amount">{{ item.price.amountMinor|money(item.price.currency) }}</span>
                </li>
            {% endfor %}
        </ul>
        <p class="muted">
            {% for total in totals %}
                {{ total.total_minor|money(total.currency) }}{{ not loop.last ? ' · ' : '' }}
            {% endfor %}
            due in total
        </p>
    {% endif %}
{% endmacro %}
