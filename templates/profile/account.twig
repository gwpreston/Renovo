{% extends 'layout.twig' %}
{% import 'partials/avatar.twig' as avatar %}

{% block heading %}{{ t('account.title') }}{% endblock %}

{% block content %}
    {#
        Shown to a member still on the temporary password an Owner gave them.
        Every other page redirects here until they replace it — see
        PasswordChangeRequiredMiddleware — so this explains why they cannot get
        anywhere else rather than leaving them to discover it.
    #}
    {% if current_user.mustChangePassword %}
        <section class="card callout">
            <h2>{{ t('account.must_change_heading') }}</h2>
            <p>{{ t('account.must_change_note') }}</p>
        </section>
    {% endif %}

    <section class="card">
        <h2>{{ t('account.who_you_are') }}</h2>

        <form method="post" action="/profile/name" class="stack">
            {{ csrf_field() }}

            <div class="field">
                <label for="display_name">{{ t('field.name') }}</label>
                <input type="text" id="display_name" name="display_name" maxlength="100" required
                       value="{{ current_user.displayName }}" autocomplete="name">
            </div>

            <button type="submit" class="button">{{ t('account.save_name') }}</button>
        </form>
    </section>

    <section class="card">
        <h2>{{ t('account.your_picture') }}</h2>

        <div class="avatar-editor">
            {{ avatar.face(
                current_user.id,
                current_user.displayName,
                current_user.initials(),
                current_user.avatarPath is not null,
                96
            ) }}

            <div class="stack">
                <form method="post" action="/profile/avatar" class="stack" enctype="multipart/form-data">
                    {{ csrf_field() }}

                    <div class="field">
                        <label for="avatar">{{ t('account.choose_picture') }}</label>
                        <input type="file" id="avatar" name="avatar" accept="image/*" required>
                        <p class="hint">
                            {{ t('account.picture_hint', { 'kilobytes': avatar_max_kilobytes }) }}
                        </p>
                    </div>

                    <button type="submit" class="button">{{ t('account.save_picture') }}</button>
                </form>

                {% if current_user.avatarPath %}
                    <form method="post" action="/profile/avatar/delete" class="inline">
                        {{ csrf_field() }}
                        <button type="submit" class="button button-quiet">
                            {{ t('account.remove_picture') }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="card">
        <h2>{{ t('account.your_email') }}</h2>

        {% if current_user.canReceiveMail() %}
            <p>{{ t('account.email_current', { 'email': current_user.email }) }}</p>

            {% if current_user.pendingEmail %}
                <p class="muted">
                    {{ t('account.email_pending', { 'email': current_user.pendingEmail }) }}
                </p>

                <form method="post" action="/profile/email/cancel" class="inline">
                    {{ csrf_field() }}
                    <button type="submit" class="button button-quiet">
                        {{ t('account.email_cancel') }}
                    </button>
                </form>
            {% endif %}

            <form method="post" action="/profile/email" class="stack">
                {{ csrf_field() }}

                <div class="field">
                    <label for="email">{{ t('account.email_new') }}</label>
                    <input type="email" id="email" name="email" required autocomplete="email">
                    <p class="hint">{{ t('account.email_hint') }}</p>
                </div>

                <button type="submit" class="button">{{ t('account.email_request') }}</button>
            </form>
        {% else %}
            <p class="muted">{{ t('account.email_none') }}</p>
        {% endif %}
    </section>

    <section class="card">
        <h2>{{ t('account.your_password') }}</h2>

        <form method="post" action="/profile/password" class="stack">
            {{ csrf_field() }}

            <div class="field">
                <label for="current_password">{{ t('account.current_password') }}</label>
                <input type="password" id="current_password" name="current_password" required
                       autocomplete="current-password">
            </div>

            <div class="field">
                <label for="password">{{ t('account.new_password') }}</label>
                <input type="password" id="password" name="password" required
                       autocomplete="new-password">
            </div>

            <div class="field">
                <label for="password_confirm">{{ t('account.confirm_password') }}</label>
                <input type="password" id="password_confirm" name="password_confirm" required
                       autocomplete="new-password">
            </div>

            <div class="field">
                <label class="choice" for="sign_out_others">
                    <input type="checkbox" id="sign_out_others" name="sign_out_others" value="1" checked>
                    <span>{{ t('account.sign_out_others') }}</span>
                </label>
                <p class="hint">{{ t('account.sign_out_others_hint') }}</p>
            </div>

            <button type="submit" class="button button-primary">{{ t('account.save_password') }}</button>
        </form>
    </section>
{% endblock %}
