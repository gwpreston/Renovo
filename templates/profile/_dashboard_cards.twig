{#
    Which cards each dashboard view shows, and in what order.

    Not part of the appearance form above: that one saves on every change, and
    a column of positions is typed one number after another — saving each
    keystroke's worth would reorder the list under the reader half-way through.
    So it keeps its own Save.

    One fieldset per view: each has its own cards, order and hiding, so the
    same card key can be arranged differently on each. The fields are keyed by
    view, and a view whose positions are not submitted is left as it was.
#}
<section class="card" id="dashboard-cards" aria-labelledby="dashboard-cards-heading">
    <h2 id="dashboard-cards-heading">{{ t('profile.dashboard_cards_heading') }}</h2>

    <form method="post" action="/profile/dashboard-cards" class="stack">
        {{ csrf_field() }}

        <p class="hint">{{ t('settings.dashboard_cards_hint') }}</p>

        {% for layout in dashboard_layouts %}
            {% set view = layout.view.value %}
            <fieldset class="stack">
                <legend>{{ t('settings.dashboard_cards_for', {'view': t(layout.view.labelKey())}) }}</legend>

                <ul class="card-layout">
                    {% for entry in layout.cards %}
                        <li class="card-layout-row">
                            <label for="card-position-{{ view }}-{{ entry.card.value }}" class="card-layout-name">
                                {{ t(entry.card.labelKey()) }}
                            </label>
                            <input type="number" min="1" max="{{ layout.cards|length }}"
                                   id="card-position-{{ view }}-{{ entry.card.value }}"
                                   name="card_position[{{ view }}][{{ entry.card.value }}]"
                                   value="{{ loop.index }}"
                                   aria-label="{{ t('settings.card_position', {
                                       'card': t(entry.card.labelKey()),
                                   }) }}">
                            <label class="choice">
                                <input type="checkbox"
                                       name="card_visible[{{ view }}][{{ entry.card.value }}]" value="1"
                                       {{ entry.visible ? 'checked' : '' }}>
                                <span>{{ t('settings.card_visible') }}</span>
                            </label>
                        </li>
                    {% endfor %}
                </ul>
            </fieldset>
        {% endfor %}

        <div class="form-actions">
            <button type="submit" class="button">{{ t('profile.dashboard_cards_save') }}</button>
        </div>
    </form>
</section>
