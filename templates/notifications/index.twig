{% extends 'layout.twig' %}

{% block heading %}{{ t('notifications.title') }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.notifications') }}{% endblock %}

{% block content %}

    <p class="muted note">
        {{ t('notifications.intro') }}
    </p>

    <section class="card">
        <h2>{{ t('notifications.when_to_tell_me') }}</h2>

        <form method="post" action="/settings/notifications/preferences" class="stack">
            {{ csrf_field() }}

            <label for="lead_days">{{ t('notifications.lead_days_label') }}</label>
            <input type="text" id="lead_days" name="lead_days"
                   value="{{ submitted.lead_days is defined ? submitted.lead_days : preferences.leadDaysAsString }}"
                   aria-describedby="lead_days_hint">
            <p class="hint" id="lead_days_hint">
                {{ t('notifications.lead_days_hint', {'example': '30, 7, 1'}) }}
            </p>
            {% if errors.lead_days is defined %}<p class="field-error">{{ error_message(errors.lead_days) }}</p>{% endif %}

            <label for="digest_mode">{{ t('notifications.delivery') }}</label>
            <select id="digest_mode" name="digest_mode">
                {% for mode in digest_modes %}
                    <option value="{{ mode.value }}"
                            {{ preferences.digestMode.value == mode.value ? 'selected' : '' }}>
                        {{ t(mode.labelKey()) }}
                    </option>
                {% endfor %}
            </select>
            <p class="hint">
                {{ t('notifications.digest_hint') }}
            </p>

            <label for="digest_day">{{ t('notifications.summary_day') }}</label>
            <input type="number" id="digest_day" name="digest_day" min="1" max="28"
                   value="{{ preferences.digestDay }}">
            <p class="hint">
                {{ t('notifications.digest_day_hint') }}
            </p>
            {% if errors.digest_day is defined %}<p class="field-error">{{ error_message(errors.digest_day) }}</p>{% endif %}

            {# The hidden field carries "off"; a ticked box overrides it with "on". #}
            <input type="hidden" name="price_change_alerts" value="0">
            <label class="choice">
                <input type="checkbox" name="price_change_alerts" value="1"
                       aria-describedby="price_change_alerts_hint"
                       {{ preferences.priceChangeAlerts ? 'checked' : '' }}>
                <span>{{ t('notifications.price_change_toggle') }}</span>
            </label>
            <p class="hint" id="price_change_alerts_hint">{{ t('notifications.price_change_hint') }}</p>

            {% if channels is not empty %}
                <h3>{{ t('notifications.where_each_alert_goes') }}</h3>
                <p class="hint">
                    {{ t('notifications.routing_hint') }}
                </p>

                <div class="table-scroll">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">{{ t('field.channel') }}</th>
                            {% for type in alert_types %}
                                <th scope="col">{{ t(type.labelKey()) }}</th>
                            {% endfor %}
                        </tr>
                        </thead>
                        <tbody>
                        {% for channel in channels %}
                            {% set configured = routes[channel.id] is defined %}
                            <tr>
                                <th scope="row">{{ channel.label }}</th>
                                {% for type in alert_types %}
                                    <td>
                                        <input type="checkbox"
                                               name="routes[{{ channel.id }}][]"
                                               value="{{ type.value }}"
                                               aria-label="{{ channel.label }}: {{ t(type.labelKey()) }}"
                                               {{ (not configured or type.value in routes[channel.id])
                                                   ? 'checked' : '' }}>
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            <button type="submit" class="button button-primary">{{ t('notifications.save_preferences') }}</button>
        </form>
    </section>

    <section class="card">
        <h2>{{ t('notifications.channels') }}</h2>

        {% if channels is empty %}
            <p class="muted empty">{{ t('notifications.channels_empty') }}</p>
        {% else %}
            <ul class="channel-list">
                {% for channel in channels %}
                    <li class="channel">
                        <div>
                            <strong>{{ channel.label }}</strong>
                            <span class="muted">{{ channel_description(channel) }}</span>
                            {% if not channel.isActive %}<span class="badge">{{ t('state.paused') }}</span>{% endif %}
                            {% if channel.lastError %}
                                <p class="field-error">{{ t('notifications.last_error', {'reason': channel.lastError}) }}</p>
                            {% elseif channel.lastSuccessAt %}
                                <p class="hint">{{ t('notifications.last_delivered', {
                                    'when': channel.lastSuccessAt|local_date('d MMM y, HH:mm'),
                                }) }}</p>
                            {% endif %}

                            <details>
                                <summary>{{ t('action.edit') }}</summary>
                                <form method="post" action="/settings/notifications/channels/{{ channel.id }}"
                                      class="stack">
                                    {{ csrf_field() }}

                                    <label for="edit_{{ channel.id }}_label">{{ t('field.name') }}</label>
                                    <input type="text" id="edit_{{ channel.id }}_label" name="label"
                                           value="{{ channel.label }}">

                                    {% for field in channel_fields(channel) %}
                                        <label for="edit_{{ channel.id }}_{{ field.name }}">{{ t(field.label) }}</label>
                                        <input type="{{ field.type }}"
                                               id="edit_{{ channel.id }}_{{ field.name }}"
                                               name="{{ field.name }}"
                                               autocomplete="off"
                                               {% if field.isSecret %}
                                                   placeholder="{{ t('notifications.secret_placeholder') }}"
                                               {% else %}
                                                   value="{{ channel.config[field.name]|default('') }}"
                                               {% endif %}>
                                        {% if field.hint %}<p class="hint">{{ t(field.hint) }}</p>{% endif %}
                                    {% endfor %}

                                    <input type="hidden" name="is_active" value="0">
                                    <label class="choice">
                                        <input type="checkbox" name="is_active" value="1"
                                               {{ channel.isActive ? 'checked' : '' }}>
                                        <span>{{ t('notifications.channel_enabled') }}</span>
                                    </label>

                                    <button type="submit" class="button">{{ t('notifications.save_channel') }}</button>
                                </form>
                            </details>
                        </div>

                        <div class="channel-actions">
                            <form method="post" action="/settings/notifications/channels/{{ channel.id }}/test"
                                  class="inline">
                                {{ csrf_field() }}
                                <button type="submit" class="button button-quiet">{{ t('action.send_test') }}</button>
                            </form>
                            <form method="post" action="/settings/notifications/channels/{{ channel.id }}/delete"
                                  class="inline">
                                {{ csrf_field() }}
                                <button type="submit" class="button button-quiet">{{ t('action.remove') }}</button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="card">
        <h2>{{ t('notifications.add_a_channel') }}</h2>

        {% for notifier in notifiers %}
            <details class="channel-form" {{ submitted.channel_type is defined
                and submitted.channel_type == notifier.key ? 'open' : '' }}>
                <summary>{{ notifier.label }}</summary>

                <form method="post" action="/settings/notifications/channels" class="stack">
                    {{ csrf_field() }}
                    <input type="hidden" name="channel_type" value="{{ notifier.key }}">

                    <label for="{{ notifier.key }}_label">{{ t('field.name') }}</label>
                    <input type="text" id="{{ notifier.key }}_label" name="label"
                           placeholder="{{ notifier.label }}">

                    {% for field in notifier.fields %}
                        <label for="{{ notifier.key }}_{{ field.name }}">{{ t(field.label) }}</label>
                        <input type="{{ field.type }}"
                               id="{{ notifier.key }}_{{ field.name }}"
                               name="{{ field.name }}"
                               {{ field.required ? 'required' : '' }}
                               autocomplete="off">
                        {% if field.hint %}<p class="hint">{{ t(field.hint) }}</p>{% endif %}
                        {% if errors[field.name] is defined %}
                            <p class="field-error">{{ errors[field.name] }}</p>
                        {% endif %}
                    {% endfor %}

                    <button type="submit" class="button">
                        {{ t('notifications.add_channel_of_type', {'type': notifier.label}) }}
                    </button>
                </form>
            </details>
        {% endfor %}
    </section>

    {% if recent is not empty %}
        <section class="card">
            <h2>{{ t('notifications.recently_sent') }}</h2>
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('field.when') }}</th>
                        <th scope="col">{{ t('field.alert') }}</th>
                        <th scope="col">{{ t('field.channel') }}</th>
                        <th scope="col">{{ t('field.result') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for entry in recent %}
                        <tr>
                            <td class="num">{{ entry.created_at|local_date('d MMM y, HH:mm') }}</td>
                            <td>{{ alert_type_label(entry.alert_type) }}</td>
                            <td>{{ entry.channel_label }}</td>
                            <td>
                                {{ entry.status }}
                                {% if entry.last_error %}<span class="muted">— {{ entry.last_error }}</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
{% endblock %}
