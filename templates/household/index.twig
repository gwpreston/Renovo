{% extends 'layout.twig' %}
{% import 'partials/avatar.twig' as avatar %}
{% import 'partials/member_share.twig' as share %}
{% import 'partials/spend.twig' as figure %}

{% block heading %}{{ t('household.title') }}{% endblock %}

{% block content %}
    <section class="card">
        <div class="budget-header num">
            <h2>{{ household ? household.name : t('members.this_household') }}</h2>
            {#
                The way through to the people themselves. Only an Owner/Admin
                may use it, and only they are shown it — the route behind it
                asserts the same permission again, so this is a courtesy and
                not the control.
            #}
            {% if can(scope, 'household.manage') %}
                <a class="button button-quiet" href="/settings/members">
                    {{ t('household.manage_members') }}
                </a>
            {% endif %}
        </div>
        <p class="muted">{{ t('household.intro') }}</p>
    </section>

    {#
        A card per person. What each card may say about money is decided in
        HouseholdOverviewService and arrives already decided — this walks the
        rows it is handed and asks nothing about isolation.
    #}
    <div class="member-grid">
        {% for row in members %}
            {% set member = row.member %}
            <section class="card member-card">
                <header class="member-identity">
                    {{ avatar.face(
                        member.userId,
                        member.displayName,
                        member.initials(),
                        member.hasAvatar,
                        48
                    ) }}
                    <span class="member-names">
                        <strong>{{ member.displayName }}</strong>
                        <span class="hint">
                            {{ role_label(member.role.value) }}
                            {%- if row.is_self %} · {{ t('settings.you') }}{% endif %}
                        </span>
                    </span>
                </header>

                {% if row.figures_withheld %}
                    {{ share.withheld() }}
                {% else %}
                    <p class="muted">{{ share.count(row) }}</p>
                    {#
                        Only where there is something to state. A member on
                        nothing, or on one-off entries alone, has already been
                        described by the line above, and the spend macro's own
                        empty case would say it again twice over — once under
                        each heading.
                    #}
                    {% if row.monthly.totals is not empty %}
                        <div class="member-figures">
                            <div>
                                <p class="stat-label">{{ t('field.per_month') }}</p>
                                {{ figure.spend(row.monthly, '') }}
                            </div>
                            <div>
                                <p class="stat-label">{{ t('field.per_year') }}</p>
                                {{ figure.spend(row.yearly, '') }}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}

                {#
                    What the role can do, answered by PermissionService itself
                    rather than written out here — so a permission that changes
                    hands changes on this card the same day.

                    Every card lists every rung, and the ones this member does
                    not have are greyed rather than left out: a list that
                    changed length from card to card could not be read across,
                    which is the whole reason for putting people side by side.

                    The grey is not the only thing saying so. The mark beside
                    each line is decoration, so each one carries a word for a
                    reader who is not looking at colours — nobody should have to
                    perceive a shade of text to learn what somebody may do.
                #}
                <h3 class="stat-label">{{ t('household.role_grants') }}</h3>
                <ul class="capability-list">
                    {% for rung in row.capabilities %}
                        <li class="capability{{ rung.held ? '' : ' is-absent' }}">
                            <span class="capability-mark" aria-hidden="true">{{ rung.held ? '✓' : '–' }}</span>
                            <span>{{ t(rung.capability.labelKey()) }}</span>
                            <span class="visually-hidden">
                                {{ t(rung.held ? 'household.capability_held' : 'household.capability_not_held') }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}
    </div>
{% endblock %}
