{% extends 'layout.twig' %}

{% block title %}Settings — {{ instance_name }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Settings</h1>
    </div>

    <section class="card">
        <h2>Signing in</h2>
        <p class="muted">
            Two-step verification, passkeys and the browsers currently signed in as you.
        </p>
        <a class="button" href="/settings/security">Account security</a>
    </section>

    <section class="card">
        <h2>API and calendar</h2>
        <p class="muted">
            Tokens for scripts, other machines and calendar apps. A token can never do more than
            you can.
        </p>
        <a class="button" href="/settings/api-tokens">API tokens</a>
    </section>

    {% if can(scope, 'data.import') or can(scope, 'backup.manage') %}
        <section class="card">
            <h2>Your data</h2>
            <p class="muted">
                Bring subscriptions in from a file, or take everything out again — including the
                attached invoices — in a format that needs no database to read.
            </p>
            <div class="form-actions">
                {% if can(scope, 'data.import') %}
                    <a class="button" href="/import">Import a file</a>
                {% endif %}
                {% if can(scope, 'backup.manage') %}
                    <a class="button" href="/settings/backup">Backup and restore</a>
                {% endif %}
            </div>
        </section>
    {% endif %}

    <section class="card">
        <h2>Appearance</h2>
        <form method="post" action="/settings/theme" class="stack">
            {{ csrf_field() }}
            <label for="theme">Theme</label>
            <select id="theme" name="theme">
                {% for theme in themes %}
                    <option value="{{ theme }}"
                            {{ current_user.theme == theme ? 'selected' : '' }}>{{ theme|capitalize }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="button">Save</button>
        </form>
    </section>

    {% if household %}
        <section class="card">
            <h2>Household</h2>

            {% if can(scope, 'household.manage') %}
                <form method="post" action="/settings/household" class="stack">
                    {{ csrf_field() }}

                    <label for="household_name">Name</label>
                    <input type="text" id="household_name" name="name" value="{{ household.name }}">

                    <h3>Members</h3>
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">Member</th>
                            <th scope="col">Role</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for member in members %}
                            <tr>
                                <td>{{ member.display_name }}</td>
                                <td>
                                    {% if member.id == current_user.id %}
                                        {{ role_label(member.role) }}
                                        <span class="hint">(you)</span>
                                    {% else %}
                                        <select name="roles[{{ member.id }}]">
                                            {% for role in roles %}
                                                <option value="{{ role.value }}"
                                                        {{ member.role == role.value ? 'selected' : '' }}>
                                                    {{ role_label(role.value) }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>

                    <button type="submit" class="button button-primary">Save household</button>
                </form>
            {% else %}
                <p><strong>{{ household.name }}</strong></p>
                <ul class="plain">
                    {% for member in members %}
                        <li>{{ member.display_name }} — {{ role_label(member.role) }}</li>
                    {% endfor %}
                </ul>
                <p class="muted">Only an owner or admin of this household can change these.</p>
            {% endif %}
        </section>
    {% endif %}

    {% if can(scope, 'instance.manage') %}
        <section class="card">
            <h2>Instance</h2>
            <p class="muted">These apply to everybody on this instance.</p>

            <form method="post" action="/settings/instance" class="stack">
                {{ csrf_field() }}

                <label for="base_currency">Base currency</label>
                <select id="base_currency" name="base_currency">
                    {% for code in currencies %}
                        <option value="{{ code }}"
                                {{ instance.base_currency == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>

                <fieldset class="stack">
                    <legend>Exchange rates</legend>
                    <p class="hint">Rates are cached and used only for display. Amounts stay in the currency
                        they were entered in. When a rate is unavailable, totals are shown per currency
                        instead of combined.</p>

                    {% for provider in rate_providers %}
                        <label class="choice">
                            <input type="radio" name="rate_provider" value="{{ provider.key }}"
                                   {{ rates.provider == provider.key ? 'checked' : '' }}>
                            <span>
                                <strong>{{ provider.label }}</strong>
                                <span class="muted block">{{ provider.description }}</span>
                            </span>
                        </label>
                    {% endfor %}

                    <label for="rate_provider_key">API key</label>
                    <input type="password" id="rate_provider_key" name="rate_provider_key" autocomplete="off"
                           placeholder="Leave blank to keep the current key">
                    <label class="choice">
                        <input type="checkbox" name="clear_rate_provider_key" value="1">
                        <span>Remove the stored API key</span>
                    </label>
                    <p class="hint"><code>EXCHANGE_RATE_API_KEY</code> in the environment overrides whatever is
                        stored here.</p>

                    <p class="muted">
                        {% if rates.is_misconfigured %}
                            <strong>{{ rates.provider_label }} needs an API key</strong> and has not been given
                            one, so no rates are being fetched.
                        {% elseif rates.last_refreshed_at %}
                            {{ rates.currency_count }} currencies cached, last updated
                            {{ rates.last_refreshed_at|date('j M Y H:i') }} UTC{{ rates.is_stale
                                ? ' — due a refresh' : '' }}.
                        {% else %}
                            No rates cached yet. They are fetched the first time a dashboard is viewed, or by
                            running <code>php bin/console rates:refresh</code>.
                        {% endif %}
                    </p>
                </fieldset>

                <fieldset class="stack">
                    <legend>Data isolation</legend>
                    {% for mode in isolation_modes %}
                        <label class="choice">
                            <input type="radio" name="isolation_mode" value="{{ mode.value }}"
                                   {{ instance.isolation_mode == mode.value ? 'checked' : '' }}>
                            <span>{{ isolation_label(mode.value) }}</span>
                        </label>
                    {% endfor %}
                </fieldset>

                <input type="hidden" name="allow_registration" value="0">
                <label class="choice">
                    <input type="checkbox" name="allow_registration" value="1"
                           {{ instance.allow_registration ? 'checked' : '' }}>
                    <span>Allow anyone to create an account</span>
                </label>

                <button type="submit" class="button button-primary">Save instance settings</button>
            </form>
        </section>

        <section class="card">
            <h2>Trusted hosts</h2>

            <p class="muted note">
                Notifications and webhooks may only be sent to addresses on the public internet. That is what
                stops somebody using a webhook URL to make this server fetch something on your private network
                — including, on a cloud host, the metadata service holding its credentials.
            </p>

            <p class="muted note">
                A self-hosted Gotify on your LAN or on a Tailscale address is on the wrong side of that rule,
                so add it here. Each entry is an exception you have chosen, and every use of one is written to
                the log. A trusted host may also be reached over plain <code>http</code>.
            </p>

            {% if trusted_hosts is empty %}
                <p class="muted empty">Nothing is trusted. Only public addresses can be reached.</p>
            {% else %}
                <div class="table-scroll">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">Host or range</th>
                            <th scope="col">Note</th>
                            <th scope="col">Added</th>
                            <th scope="col"></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for host in trusted_hosts %}
                            <tr>
                                <td><code>{{ host.pattern }}</code></td>
                                <td>{{ host.note }}</td>
                                <td>
                                    {{ host.created_at|date('j M Y') }}
                                    {% if host.created_by %}<span class="muted">by {{ host.created_by }}</span>{% endif %}
                                </td>
                                <td>
                                    <form method="post" action="/settings/trusted-hosts/{{ host.id }}/delete"
                                          class="inline">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-quiet">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            <form method="post" action="/settings/trusted-hosts" class="stack">
                {{ csrf_field() }}

                <label for="trusted_pattern">Host, address or range</label>
                <input type="text" id="trusted_pattern" name="pattern"
                       placeholder="gotify.lan, .lan, 192.168.1.10 or 100.64.0.0/10" required>

                <label for="trusted_note">Note</label>
                <input type="text" id="trusted_note" name="note" placeholder="What this is, for later">

                <button type="submit" class="button">Trust this host</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
