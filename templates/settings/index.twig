{% extends 'layout.twig' %}

{% block title %}Settings — {{ instance_name }}{% endblock %}

{% block content %}
    <div class="page-header">
        <h1>Settings</h1>
    </div>

    <section class="card">
        <h2>Appearance</h2>
        <form method="post" action="/settings/theme" class="stack">
            {{ csrf_field() }}
            <label for="theme">Theme</label>
            <select id="theme" name="theme">
                {% for theme in themes %}
                    <option value="{{ theme }}"
                            {{ current_user.theme == theme ? 'selected' : '' }}>{{ theme|capitalize }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="button">Save</button>
        </form>
    </section>

    {% if household %}
        <section class="card">
            <h2>Household</h2>

            {% if can(scope, 'household.manage') %}
                <form method="post" action="/settings/household" class="stack">
                    {{ csrf_field() }}

                    <label for="household_name">Name</label>
                    <input type="text" id="household_name" name="name" value="{{ household.name }}">

                    <h3>Members</h3>
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">Member</th>
                            <th scope="col">Role</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for member in members %}
                            <tr>
                                <td>{{ member.display_name }}</td>
                                <td>
                                    {% if member.id == current_user.id %}
                                        {{ role_label(member.role) }}
                                        <span class="hint">(you)</span>
                                    {% else %}
                                        <select name="roles[{{ member.id }}]">
                                            {% for role in roles %}
                                                <option value="{{ role.value }}"
                                                        {{ member.role == role.value ? 'selected' : '' }}>
                                                    {{ role_label(role.value) }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>

                    <button type="submit" class="button button-primary">Save household</button>
                </form>
            {% else %}
                <p><strong>{{ household.name }}</strong></p>
                <ul class="plain">
                    {% for member in members %}
                        <li>{{ member.display_name }} — {{ role_label(member.role) }}</li>
                    {% endfor %}
                </ul>
                <p class="muted">Only an owner or admin of this household can change these.</p>
            {% endif %}
        </section>
    {% endif %}

    {% if can(scope, 'instance.manage') %}
        <section class="card">
            <h2>Instance</h2>
            <p class="muted">These apply to everybody on this instance.</p>

            <form method="post" action="/settings/instance" class="stack">
                {{ csrf_field() }}

                <label for="instance_name">Instance name</label>
                <input type="text" id="instance_name" name="instance_name" value="{{ instance.name }}">

                <label for="base_currency">Base currency</label>
                <select id="base_currency" name="base_currency">
                    {% for code in currencies %}
                        <option value="{{ code }}"
                                {{ instance.base_currency == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>

                <fieldset class="stack">
                    <legend>Exchange rates</legend>
                    <p class="hint">Rates are cached and used only for display. Amounts stay in the currency
                        they were entered in. When a rate is unavailable, totals are shown per currency
                        instead of combined.</p>

                    {% for provider in rate_providers %}
                        <label class="choice">
                            <input type="radio" name="rate_provider" value="{{ provider.key }}"
                                   {{ rates.provider == provider.key ? 'checked' : '' }}>
                            <span>
                                <strong>{{ provider.label }}</strong>
                                <span class="muted block">{{ provider.description }}</span>
                            </span>
                        </label>
                    {% endfor %}

                    <label for="rate_provider_key">API key</label>
                    <input type="password" id="rate_provider_key" name="rate_provider_key" autocomplete="off"
                           placeholder="Leave blank to keep the current key">
                    <label class="choice">
                        <input type="checkbox" name="clear_rate_provider_key" value="1">
                        <span>Remove the stored API key</span>
                    </label>
                    <p class="hint"><code>EXCHANGE_RATE_API_KEY</code> in the environment overrides whatever is
                        stored here.</p>

                    <p class="muted">
                        {% if rates.is_misconfigured %}
                            <strong>{{ rates.provider_label }} needs an API key</strong> and has not been given
                            one, so no rates are being fetched.
                        {% elseif rates.last_refreshed_at %}
                            {{ rates.currency_count }} currencies cached, last updated
                            {{ rates.last_refreshed_at|date('j M Y H:i') }} UTC{{ rates.is_stale
                                ? ' — due a refresh' : '' }}.
                        {% else %}
                            No rates cached yet. They are fetched the first time a dashboard is viewed, or by
                            running <code>php bin/console rates:refresh</code>.
                        {% endif %}
                    </p>
                </fieldset>

                <fieldset class="stack">
                    <legend>Data isolation</legend>
                    {% for mode in isolation_modes %}
                        <label class="choice">
                            <input type="radio" name="isolation_mode" value="{{ mode.value }}"
                                   {{ instance.isolation_mode == mode.value ? 'checked' : '' }}>
                            <span>{{ isolation_label(mode.value) }}</span>
                        </label>
                    {% endfor %}
                </fieldset>

                <input type="hidden" name="allow_registration" value="0">
                <label class="choice">
                    <input type="checkbox" name="allow_registration" value="1"
                           {{ instance.allow_registration ? 'checked' : '' }}>
                    <span>Allow anyone to create an account</span>
                </label>

                <button type="submit" class="button button-primary">Save instance settings</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
