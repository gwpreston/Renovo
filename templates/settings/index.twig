{% extends 'layout.twig' %}

{% block heading %}{{ t('nav.settings') }}{% endblock %}

{% block content %}

    {% if can(scope, 'data.import') or can(scope, 'backup.manage') %}
        <section class="card">
            <h2>{{ t('settings.your_data') }}</h2>
            <p class="muted">
                {{ t('settings.data_intro') }}
            </p>
            <div class="form-actions">
                {% if can(scope, 'data.import') %}
                    <a class="button" href="/import">{{ t('settings.import_a_file') }}</a>
                {% endif %}
                {% if can(scope, 'backup.manage') %}
                    <a class="button" href="/settings/backup">{{ t('backup.title') }}</a>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {% if household %}
        <section class="card">
            <h2>{{ t('settings.household') }}</h2>

            {% if can(scope, 'household.manage') %}
                <form method="post" action="/settings/household" class="stack">
                    {{ csrf_field() }}

                    <label for="household_name">{{ t('field.name') }}</label>
                    <input type="text" id="household_name" name="name" value="{{ household.name }}">

                    <button type="submit" class="button">{{ t('settings.save_household') }}</button>
                </form>

                {#
                    Who is in the household is a screen of its own. It outgrew a
                    fieldset the moment each person needed a status and six
                    actions, and it is where the last-Owner guard and the audit
                    entries live.
                #}
                <h3>{{ t('settings.members') }}</h3>
                <ul class="plain">
                    {% for member in members %}
                        <li>{{ member.display_name }} — {{ role_label(member.role) }}</li>
                    {% endfor %}
                </ul>
                <p class="form-actions">
                    <a class="button" href="/settings/members">{{ t('settings.manage_members') }}</a>
                </p>
            {% else %}
                <p><strong>{{ household.name }}</strong></p>
                <ul class="plain">
                    {% for member in members %}
                        <li>{{ member.display_name }} — {{ role_label(member.role) }}</li>
                    {% endfor %}
                </ul>
                <p class="muted">{{ t('settings.household_permission_note') }}</p>
            {% endif %}
        </section>
    {% endif %}

    {% if can(scope, 'instance.manage') %}
        <section class="card">
            <h2>{{ t('settings.instance') }}</h2>
            <p class="muted">{{ t('settings.instance_note') }}</p>

            <form method="post" action="/settings/instance" class="stack">
                {{ csrf_field() }}

                <label for="base_currency">{{ t('settings.base_currency') }}</label>
                <select id="base_currency" name="base_currency">
                    {% for code in currencies %}
                        <option value="{{ code }}"
                                {{ instance.base_currency == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>

                <fieldset class="stack">
                    <legend>{{ t('settings.exchange_rates') }}</legend>
                    <p class="hint">{{ t('settings.rates_note') }}</p>

                    {% for provider in rate_providers %}
                        <label class="choice">
                            <input type="radio" name="rate_provider" value="{{ provider.key }}"
                                   {{ rates.provider == provider.key ? 'checked' : '' }}>
                            <span>
                                <strong>{{ provider.label }}</strong>
                                <span class="muted block">{{ t(provider.descriptionKey) }}</span>
                            </span>
                        </label>
                    {% endfor %}

                    <label for="rate_provider_key">{{ t('settings.api_key') }}</label>
                    <input type="password" id="rate_provider_key" name="rate_provider_key" autocomplete="off"
                           placeholder="{{ t('settings.rate_key_placeholder') }}">
                    <label class="choice">
                        <input type="checkbox" name="clear_rate_provider_key" value="1">
                        <span>{{ t('settings.rate_key_clear') }}</span>
                    </label>
                    <p class="hint">{{ t('settings.rate_key_env_wins', {'variable': 'EXCHANGE_RATE_API_KEY'}) }}</p>

                    <p class="muted">
                        {% if rates.is_misconfigured %}
                            {{ t('settings.rates_need_key', {'provider': rates.provider_label}) }}
                        {% elseif rates.last_refreshed_at %}
                            {{ t('settings.rates_cached', {
                                'count': rates.currency_count,
                                'when': rates.last_refreshed_at|local_date('d MMM y HH:mm'),
                            }) }}
                            {%- if rates.is_stale %} {{ t('settings.rates_stale') }}{% endif %}
                        {% else %}
                            {{ t('settings.rates_none') }}
                            <code>php bin/console rates:refresh</code>.
                        {% endif %}
                    </p>
                </fieldset>

                <fieldset class="stack">
                    <legend>{{ t('settings.data_isolation') }}</legend>
                    {% for mode in isolation_modes %}
                        <label class="choice">
                            <input type="radio" name="isolation_mode" value="{{ mode.value }}"
                                   {{ instance.isolation_mode == mode.value ? 'checked' : '' }}>
                            <span>{{ isolation_label(mode.value) }}</span>
                        </label>
                    {% endfor %}
                </fieldset>

                <input type="hidden" name="allow_registration" value="0">
                <label class="choice">
                    <input type="checkbox" name="allow_registration" value="1"
                           {{ instance.allow_registration ? 'checked' : '' }}>
                    <span>{{ t('settings.allow_registration') }}</span>
                </label>

                <input type="hidden" name="demo_mode" value="0">
                <label class="choice">
                    <input type="checkbox" name="demo_mode" value="1"
                           {{ instance.demo_mode ? 'checked' : '' }}>
                    <span>{{ t('settings.demo_mode') }}</span>
                </label>
                <p class="hint">{{ t('settings.demo_mode_hint') }}</p>

                <button type="submit" class="button">{{ t('settings.save_instance_settings') }}</button>
            </form>
        </section>

        <section class="card">
            <h2>{{ t('settings.trusted_hosts') }}</h2>

            <p class="muted note">
                {{ t('settings.trusted_hosts_intro') }}
            </p>

            <p class="muted note">
                {{ t('settings.trusted_hosts_exception') }} <code>http</code>.
            </p>

            {% if trusted_hosts is empty %}
                <p class="muted empty">{{ t('settings.trusted_hosts_empty') }}</p>
            {% else %}
                <div class="table-scroll">
                    <table class="table">
                        <thead>
                        <tr>
                            <th scope="col">{{ t('settings.host_or_range') }}</th>
                            <th scope="col">{{ t('field.note') }}</th>
                            <th scope="col">{{ t('field.added') }}</th>
                            <th scope="col"></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for host in trusted_hosts %}
                            <tr>
                                <td><code>{{ host.pattern }}</code></td>
                                <td>{{ host.note }}</td>
                                <td>
                                    {{ host.created_at|local_date('d MMM y') }}
                                    {% if host.created_by %}<span class="muted">by {{ host.created_by }}</span>{% endif %}
                                </td>
                                <td>
                                    <form method="post" action="/settings/trusted-hosts/{{ host.id }}/delete"
                                          class="inline">
                                        {{ csrf_field() }}
                                        <button type="submit" class="button button-quiet">{{ t('action.remove') }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            <form method="post" action="/settings/trusted-hosts" class="stack">
                {{ csrf_field() }}

                <label for="trusted_pattern">{{ t('settings.host_address_or_range') }}</label>
                <input type="text" id="trusted_pattern" name="pattern"
                       placeholder="{{ t('settings.trusted_host_placeholder') }}" required>

                <label for="trusted_note">{{ t('field.note') }}</label>
                <input type="text" id="trusted_note" name="note" placeholder="{{ t('settings.trusted_host_note_placeholder') }}">

                <button type="submit" class="button">{{ t('settings.trust_this_host') }}</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
