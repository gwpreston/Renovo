{#
    Removing a member: the members screen's dialog loads this, and without
    script it is a page of its own.

    Where the member owns rows nobody else has seen, the question of what
    happens to them is asked with no answer chosen in advance, and the service
    refuses a removal that comes back without one. In ISOLATED that is every
    row they own; in SHARED only their "only me" subscriptions, because the
    household could already see the rest and handing those to an Owner changes
    nothing anybody can see.
#}
{% extends is_htmx ? 'partials/bare.twig' : 'layout.twig' %}

{% block heading %}{{ t('members.remove_heading', { 'name': member.displayName }) }}{% endblock %}
{% block page_subtitle %}{{ t('subtitle.member_remove') }}{% endblock %}

{% block content %}
    <section class="card narrow member-remove">
        <p>{{ t('members.remove_intro', { 'name': member.displayName }) }}</p>
        <p class="muted">{{ t('members.remove_account_kept') }}</p>

        <form method="post" action="/settings/members/{{ member.userId }}/remove" class="stack">
            {{ csrf_field() }}

            {% if is_isolated and owned_rows > 0 %}
                <fieldset class="stack">
                    <legend>{{ t('members.remove_data_legend', { 'count': owned_rows }) }}</legend>

                    <label class="choice">
                        <input type="radio" name="data" value="reassign" required>
                        <span>{{ t('members.remove_data_reassign') }}</span>
                    </label>

                    <label class="choice">
                        <input type="radio" name="data" value="delete" required>
                        <span>{{ t('members.remove_data_delete') }}</span>
                    </label>
                </fieldset>
            {% elseif not is_isolated %}
                <input type="hidden" name="data" value="reassign">
                <p class="muted">{{ t('members.remove_data_shared') }}</p>

                {% if private_rows > 0 %}
                    <fieldset class="stack">
                        <legend>{{ t('members.remove_private_legend', { 'count': private_rows }) }}</legend>

                        <label class="choice">
                            <input type="radio" name="private_data" value="reassign" required>
                            <span>{{ t('members.remove_private_reassign') }}</span>
                        </label>

                        <label class="choice">
                            <input type="radio" name="private_data" value="delete" required>
                            <span>{{ t('members.remove_private_delete') }}</span>
                        </label>
                    </fieldset>
                {% endif %}
            {% endif %}

            <div class="form-actions">
                <button type="submit" class="button button-danger">{{ t('members.remove_confirm') }}</button>
                <a class="button button-quiet" href="/settings/members" data-closes-dialog="member-dialog">{{ t('action.cancel') }}</a>
            </div>
        </form>
    </section>
{% endblock %}
