{% extends 'layout.twig' %}

{% block heading %}{{ t('stats.title') }}{% endblock %}

{#
    Analytics is one rail item covering two screens: this one, which says what
    has happened, and the forecast, which says what is about to. The forecast
    has no rail entry of its own — the design gives Analytics one row — so this
    is the link that keeps it one click away, and the keyboard's `g f` and this
    button reach the same page.
#}
{% block page_actions %}
    <a class="button button-quiet" href="/forecast">{{ t('nav.forecast') }}</a>
{% endblock %}

{% block content %}
    {#
        The design's arrangement: the KPI row, the twelve months behind and the
        spending trajectory ahead, the category donut, and the comparative
        pair. Not one figure on any of them is computed for this screen — the
        KPIs are the statistics this page already reported, the trajectory is
        the dashboard's own chart payload, the months behind it are the
        reconstruction year over year is totalled from, the donut is the
        breakdown the my-subscriptions widget draws as bars, and year over year
        is that same reconstruction stated as a pair of totals.

        Below them, what this page has always carried and the design has no
        place for: the same cost expressed over each period people think in, and
        the cost-per-use ranking.
    #}
    {#
        The insight card leads, when there is one. It is the only thing on this
        screen that tells the member to go and do something, so burying it beneath
        the figures it is drawn from would be the wrong way round; and when no
        rule fired it is absent entirely and the page begins where it used to.
    #}
    {% include 'stats/_insight.twig' %}

    {% include 'stats/_kpis.twig' %}

    {#
        The two twelve-month charts are stacked in the main column, the year
        behind above the year ahead, so they are read in the order they
        happened and share an x-axis width the eye can carry a figure across.
        The donut keeps the side column beside both of them; the layout's gap
        is horizontal only, so cards space themselves vertically with their own
        margin and the stack needs nothing new from the stylesheet.
    #}
    <div class="analytics-layout">
        <div class="analytics-main">
            {% include 'stats/_history.twig' %}
            {% include 'stats/_trajectory.twig' %}
        </div>
        <aside class="analytics-side">
            {% include 'stats/_categories.twig' %}
        </aside>
    </div>

    {% include 'stats/_comparison.twig' %}

    <section class="card">
        <h2>{{ t('stats.per_period') }}</h2>

        <div class="stat-grid stat-grid-inline">
            {% for label, amount in per_period %}
                <div class="stat">
                    <h3 class="stat-label">{{ t('period.per_' ~ label) }}</h3>
                    <p class="stat-value">
                        {{ amount is not null ? amount|money(combined_yearly.currency) : '—' }}
                    </p>
                </div>
            {% endfor %}
        </div>

        {% if combined_yearly.amount_minor is null %}
            <p class="muted note">
                {{ t('stats.unconvertible', {
                    'currency': base_currency,
                    'currencies': combined_yearly.unconvertible|join(', '),
                }) }}
            </p>
            <h3 class="stat-label">{{ t('stats.per_year_heading') }}</h3>
            <ul class="plain">
                {% for total in yearly_by_currency %}
                    <li>{{ total.amount_minor|money(total.currency) }}</li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="hint">{{ t('stats.per_year_note') }}</p>
        {% endif %}
    </section>

    <section class="card">
        <h2>{{ t('stats.worth_it') }}</h2>
        <p class="muted">{{ t('stats.value_note') }}</p>

        {% if value_signals is empty %}
            <p class="muted empty">{{ t('stats.value_empty') }}</p>
        {% else %}
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('field.subscription') }}</th>
                        <th scope="col" class="numeric">{{ t('field.per_month') }}</th>
                        <th scope="col" class="numeric">{{ t('field.uses') }}</th>
                        <th scope="col" class="numeric">{{ t('stats.cost_per_use') }}</th>
                        <th scope="col">{{ t('field.rating') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ t('field.actions') }}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for signal in value_signals %}
                        {% set subscription = signal.subscription %}
                        <tr class="{{ signal.is_low_use ? 'is-urgent' : '' }}">
                            <td>
                                <a href="/subscriptions/{{ subscription.id }}/money">{{ subscription.name }}</a>
                                {% if signal.is_low_use %}
                                    <span class="badge badge-warning">{{ t('stats.rarely_used') }}</span>
                                {% endif %}
                            </td>
                            <td class="numeric">{{
                                subscription.monthlyMinor|money(subscription.price.currency) }}</td>
                            <td class="numeric">
                                {{ subscription.usageCount }}
                                {% if signal.uses_per_month is not null %}
                                    <div class="hint">{{ t('stats.uses_per_month', {
                                        'count': signal.uses_per_month|number_format(1),
                                    }) }}</div>
                                {% endif %}
                            </td>
                            <td class="numeric">
                                {% if signal.cost_per_use_minor is not null %}
                                    {{ signal.cost_per_use_minor|money(subscription.price.currency) }}
                                {% else %}
                                    <span class="muted" title="{{ t('stats.no_uses_recorded') }}">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if subscription.usageRating %}
                                    <span aria-label="{{ t('stats.rating_label', {
                                        'rating': subscription.usageRating,
                                        'max': max_rating,
                                    }) }}">
                                        {%- for star in 1..max_rating -%}
                                            {{ star <= subscription.usageRating ? '★' : '☆' }}
                                        {%- endfor -%}
                                    </span>
                                {% else %}
                                    <span class="muted">—</span>
                                {% endif %}
                            </td>
                            <td class="actions">
                                {% if can(scope, 'usage.record') %}
                                    <form method="post" action="/subscriptions/{{ subscription.id }}/usage"
                                          class="inline">
                                        {{ csrf_field() }}
                                        <input type="hidden" name="return_to" value="/stats">
                                        <button type="submit" class="button button-quiet">{{ t('stats.used_it') }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
