{% extends 'layout.twig' %}

{% block heading %}{{ t('stats.title') }}{% endblock %}

{#
    Analytics is one rail item covering two screens: this one, which says what
    has happened, and the forecast, which says what is about to. The forecast
    has no rail entry of its own — the design gives Analytics one row — so this
    is the link that keeps it one click away, and the keyboard's `g f` and this
    button reach the same page.
#}
{% block page_actions %}
    <a class="button button-quiet" href="/forecast">{{ t('nav.forecast') }}</a>
{% endblock %}

{% block content %}

    <section class="stat-grid">
        {% for label, amount in per_period %}
            <article class="card stat">
                <h2 class="stat-label">{{ t('period.per_' ~ label) }}</h2>
                <p class="stat-value">
                    {{ amount is not null ? amount|money(combined_yearly.currency) : '—' }}
                </p>
            </article>
        {% endfor %}
    </section>

    {% if combined_yearly.amount_minor is null %}
        <p class="muted note">
            {{ t('stats.unconvertible', {
                'currency': base_currency,
                'currencies': combined_yearly.unconvertible|join(', '),
            }) }}
        </p>
        <section class="card">
            <h2>{{ t('stats.per_year_heading') }}</h2>
            <ul class="plain">
                {% for currency, amount in by_currency %}
                    <li>{{ amount|money(currency) }}</li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <p class="muted note">
            {{ t('stats.per_year_note') }}
        </p>
    {% endif %}

    <section class="card">
        <h2>{{ t('stats.year_over_year') }}</h2>
        {% set yoy = year_over_year %}

        {% if yoy.current.amount_minor is null or yoy.previous.amount_minor is null %}
            <p class="muted">{{ t('stats.year_over_year_empty') }}</p>
        {% elseif yoy.previous.amount_minor == 0 %}
            <p class="muted">
                {{ t('stats.no_previous_year', {
                    'amount': yoy.current.amount_minor|money(yoy.current.currency),
                }) }}
            </p>
        {% else %}
            <div class="columns">
                <div>
                    <h3 class="stat-label">{{ t('stats.last_12_months') }}</h3>
                    <p class="stat-value">{{ yoy.current.amount_minor|money(yoy.current.currency) }}</p>
                </div>
                <div>
                    <h3 class="stat-label">{{ t('stats.the_12_before_that') }}</h3>
                    <p class="stat-value">{{ yoy.previous.amount_minor|money(yoy.previous.currency) }}</p>
                </div>
                <div>
                    <h3 class="stat-label">{{ t('field.change') }}</h3>
                    <p class="stat-value {{ yoy.change_minor > 0 ? 'is-increase' : 'is-decrease' }}">
                        {{ yoy.change_minor > 0 ? '+' : '' }}{{ yoy.change_minor|money(yoy.current.currency) }}
                        {% if yoy.change_percent is not null %}
                            <span class="stat-unit">({{ yoy.change_percent > 0 ? '+' : '' }}{{
                                yoy.change_percent }}%)</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        {% endif %}

        <p class="hint">
            {{ t('stats.year_over_year_note') }}
            {% if yoy.excluded_count > 0 %}
                {{ t('stats.year_over_year_excluded', {'count': yoy.excluded_count}) }}
            {% endif %}
        </p>
    </section>

    <section class="card">
        <h2>{{ t('stats.worth_it') }}</h2>
        <p class="muted">{{ t('stats.value_note') }}</p>

        {% if value_signals is empty %}
            <p class="muted empty">{{ t('stats.value_empty') }}</p>
        {% else %}
            <div class="table-scroll">
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">{{ t('field.subscription') }}</th>
                        <th scope="col" class="numeric">{{ t('field.per_month') }}</th>
                        <th scope="col" class="numeric">{{ t('field.uses') }}</th>
                        <th scope="col" class="numeric">{{ t('stats.cost_per_use') }}</th>
                        <th scope="col">{{ t('field.rating') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ t('field.actions') }}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for signal in value_signals %}
                        {% set subscription = signal.subscription %}
                        <tr class="{{ signal.is_low_use ? 'is-urgent' : '' }}">
                            <td>
                                <a href="/subscriptions/{{ subscription.id }}/money">{{ subscription.name }}</a>
                                {% if signal.is_low_use %}
                                    <span class="badge badge-warning">{{ t('stats.rarely_used') }}</span>
                                {% endif %}
                            </td>
                            <td class="numeric">{{
                                subscription.monthlyMinor|money(subscription.price.currency) }}</td>
                            <td class="numeric">
                                {{ subscription.usageCount }}
                                {% if signal.uses_per_month is not null %}
                                    <div class="hint">{{ t('stats.uses_per_month', {
                                        'count': signal.uses_per_month|number_format(1),
                                    }) }}</div>
                                {% endif %}
                            </td>
                            <td class="numeric">
                                {% if signal.cost_per_use_minor is not null %}
                                    {{ signal.cost_per_use_minor|money(subscription.price.currency) }}
                                {% else %}
                                    <span class="muted" title="{{ t('stats.no_uses_recorded') }}">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if subscription.usageRating %}
                                    <span aria-label="{{ t('stats.rating_label', {
                                        'rating': subscription.usageRating,
                                        'max': max_rating,
                                    }) }}">
                                        {%- for star in 1..max_rating -%}
                                            {{ star <= subscription.usageRating ? '★' : '☆' }}
                                        {%- endfor -%}
                                    </span>
                                {% else %}
                                    <span class="muted">—</span>
                                {% endif %}
                            </td>
                            <td class="actions">
                                {% if can(scope, 'usage.record') %}
                                    <form method="post" action="/subscriptions/{{ subscription.id }}/usage"
                                          class="inline">
                                        {{ csrf_field() }}
                                        <input type="hidden" name="return_to" value="/stats">
                                        <button type="submit" class="button button-quiet">{{ t('stats.used_it') }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
