{#
    The spend-insight card.

    The design puts an "AI Insight" hero at the top of this screen, reading
    "cancel Adobe Stock, save $540/year". There is no model behind this one and
    it is not labelled as though there were: every line is a rule over the
    household's own subscriptions, and every figure is that subscription's own
    money — so the member can check it against their bill, which is the whole
    point of stating it.

    The leading insight is the card; the rest fold away behind a `<details>`,
    which needs no script to open. When no rule fired there is no card at all:
    an empty gradient box saying "nothing to report" is a worse answer than the
    page simply beginning at the KPI row.

    Nothing here decides anything. `SpendInsightService` ranked the list and
    worked out the figures; this chooses the wording for each kind and formats
    the money and the dates through the same filters the rest of the screen
    uses.
#}
{#
    Twig 3 removed calling a macro through `_self` directly, so the two wording
    macros at the foot of this file are imported by name.
#}
{% import _self as wording %}

{% if insights is not empty %}
    {% set lead = insights|first %}

    <section class="card card-featured insight-card" id="analytics-insight"
             aria-labelledby="analytics-insight-heading">
        <h2 id="analytics-insight-heading" class="stat-label">{{ t('insight.title') }}</h2>

        <p class="insight-headline">{{ wording.headline(lead) }}</p>
        <p class="insight-detail">{{ wording.detail(lead) }}</p>

        {#
            The action PHASE.md asks for. It is an ordinary link to the
            subscription's money page, which enforces its own permissions — the
            insight was derived from rows this member can already see, and the
            link is not what makes that true.

            It is also this screen's one filled button, and the only one on it.
            Everything else here is a figure; this is the single place the
            screen asks the member to go and do something, which is exactly
            what the accent is reserved for.
        #}
        <p class="insight-action">
            <a class="button button-primary" href="/subscriptions/{{ lead.subscription.id }}/money">
                {{ t('insight.action') }}
            </a>
        </p>

        {% if insights|length > 1 %}
            <details class="insight-more">
                <summary>{{ t('insight.more', {'count': insights|length - 1}) }}</summary>
                <ul class="plain insight-list">
                    {% for insight in insights|slice(1) %}
                        <li class="insight-row">
                            <h3>{{ wording.headline(insight) }}</h3>
                            <p>{{ wording.detail(insight) }}</p>
                            <p>
                                <a href="/subscriptions/{{ insight.subscription.id }}/money">
                                    {{ t('insight.action') }}
                                </a>
                            </p>
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}

        <p class="hint">{{ t('insight.note') }}</p>
    </section>
{% endif %}

{#
    Each kind's heading. The overlap one carries the category and the count,
    because "two subscriptions in Design" is the observation itself rather than
    a decoration on it.
#}
{% macro headline(insight) %}
    {%- if insight.kind.value == 'overlap' -%}
        {{ t('insight.overlap.headline', {
            'count': insight.count,
            'category': insight.category_name,
        }) }}
    {%- else -%}
        {{ t(insight.kind.labelKey) }}
    {%- endif -%}
{% endmacro %}

{#
    Each kind's sentence: the subscriptions it is about, and the arithmetic.

    Every amount is printed in the currency the service attached to it — one
    subscription's own — so nothing here is a converted figure and no two
    currencies are added together.
#}
{% macro detail(insight) %}
    {%- set kind = insight.kind.value -%}
    {%- set amount = insight.annual_minor|money(insight.currency) -%}
    {%- if kind == 'trial_converting' -%}
        {{ t('insight.trial_converting.detail', {
            'name': insight.subscription.name,
            'date': insight.date|local_date,
            'days': insight.days,
            'amount': amount,
        }) }}
    {%- elseif kind == 'price_rising' or kind == 'price_risen' -%}
        {{ t(insight.kind.detailKey, {
            'name': insight.subscription.name,
            'difference': insight.difference_minor|money(insight.currency),
            'date': insight.date|local_date,
            'amount': amount,
        }) }}
    {%- elseif kind == 'overlap' -%}
        {{ t('insight.overlap.detail', {
            'name': insight.subscription.name,
            'amount': amount,
            'others': insight.related|map(other => other.name)|join(', '),
        }) }}
    {%- else -%}
        {{ t('insight.rarely_used.detail', {
            'name': insight.subscription.name,
            'amount': amount,
            'count': insight.count,
        }) }}
        {%- if insight.cost_per_use_minor is not null %}
            {{ t('insight.rarely_used.per_use', {
                'amount': insight.cost_per_use_minor|money(insight.currency),
            }) }}
        {%- endif -%}
    {%- endif -%}
{% endmacro %}
