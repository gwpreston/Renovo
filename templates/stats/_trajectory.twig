{#
    The spending trajectory.

    The design's orange gradient bars are the twelve-month view, and they are
    the dashboard's chart: the same `ForecastService::monthly()` call, the same
    `SpendChartService` payload, the same partial. The two screens agree about
    March by construction rather than by coincidence, which is the whole reason
    this reuses the Phase 10 chart instead of adding a second one.

    Each renewal falls in the month it actually falls; a scheduled price change
    or a trial conversion applies from its own date, so a point does not move
    when the change eventually lands. The second line is those months without
    the trials, so the gap between the two is the spend that is coming but is
    not committed yet.
#}
{% import 'partials/spend_chart.twig' as trend %}

<section class="card chart-card" id="analytics-trajectory">
    <header class="card-header">
        <h2>{{ t('stats.trajectory') }}</h2>
        <a class="button button-quiet" href="/forecast">{{ t('nav.forecast') }}</a>
    </header>

    <p class="muted">{{ t('stats.trajectory_note') }}</p>

    {{ trend.spend_chart(
        trajectory,
        'analytics-trajectory-data',
        trajectory.has_trials
            ? t('dashboard.spend_chart_alt', {'currency': trajectory.currency})
            : t('dashboard.spend_chart_alt_single', {'currency': trajectory.currency}),
        t('dashboard.part_month_note'),
        t('dashboard.chart_unconvertible', {
            'currencies': trajectory.unconvertible|join(', '),
            'currency': trajectory.currency,
        })
    ) }}
</section>
