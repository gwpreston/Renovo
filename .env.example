# ---------------------------------------------------------------------------
# Renovo configuration. Copy to `.env` and edit. Never commit `.env`.
# ---------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_NAME="Renovo"
# Absolute base URL of this instance. Used to build links in emails.
APP_URL=http://localhost:8080

# Host port the web server is published on. Change it if 8080 is taken, and
# keep APP_URL in step.
APP_PORT=8080

# ---------------------------------------------------------------------------
# Database. Local development uses the SAME engine as production. No SQLite.
# DB_DRIVER: pgsql | mysql
# ---------------------------------------------------------------------------
DB_DRIVER=pgsql
# Host-side value, used by phinx/phpunit/psql when you run them on your machine.
# The containers get DB_HOST=database from docker-compose.yml regardless.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=renovo
DB_USER=renovo
DB_PASSWORD=change-me
DB_CHARSET=utf8

# Host port the database is published on, bound to loopback only. This is for
# tools you run on your own machine (phinx, phpunit, psql); the containers
# always reach the database at the internal hostname regardless.
#
# Left unset on purpose: it then follows the engine in use (5432 for
# PostgreSQL, 3306 for MySQL). Set it only to move the database off a port
# something else already holds.
#DB_PORT_PUBLISHED=5432

# Only used by the MySQL compose variant, for its healthcheck and for creating
# the test database.
DB_ROOT_PASSWORD=renovo-root

# ---------------------------------------------------------------------------
# Sessions. SESSION_KEY must be a long random string; rotating it logs
# everybody out. Generate one with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_KEY=
SESSION_NAME=renovo_session
SESSION_LIFETIME_SECONDS=1209600
# Set to false only when serving over plain HTTP on a trusted network.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# Outbound mail (SMTP). Symfony Mailer DSN is derived from these.
# ---------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# tls | ssl | none
SMTP_ENCRYPTION=none
MAIL_FROM_ADDRESS=renovo@localhost
MAIL_FROM_NAME="Renovo"

# Host port for the development mail catcher's web interface.
MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Shared outbound HTTP client. Every external call goes through it.
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_RESPONSE_BYTES=2097152
HTTP_MAX_REDIRECTS=3
HTTP_USER_AGENT="Renovo"
# Standard proxy variables are honoured if set.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# ---------------------------------------------------------------------------
# Exchange rates. The provider itself is chosen in the first-run wizard or in
# instance settings; these control caching and the (optional) key.
# ---------------------------------------------------------------------------
# How long a cached rate table stays current. Twelve hours by default — the
# free feeds publish once a working day.
EXCHANGE_RATE_TTL_SECONDS=43200
# Minimum gap between refresh attempts, so a provider outage does not mean a
# failed network call on every page view.
EXCHANGE_RATE_RETRY_SECONDS=3600
# Only needed by providers that require one (exchangerate.host, Fixer). Set it
# here to keep the key out of the database entirely; it takes precedence over
# anything entered in the wizard or settings page.
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Authentication throttling. Windows are in seconds.
# ---------------------------------------------------------------------------
AUTH_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_MAX_ATTEMPTS_PER_IP=20
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_MAX_LOGO_BYTES=1048576
